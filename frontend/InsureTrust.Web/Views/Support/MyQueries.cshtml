@model InsureTrust.Web.Models.SupportQueryListViewModel

@{
    ViewData["Title"] = "My Support Queries";
}

<section class="fade-in-up">
    <div class="page-heading d-flex justify-content-between align-items-center mb-5">
        <div>
            <span class="meta-line"><i class="fa-solid fa-headset me-1"></i> Help Center</span>
            <h1 class="display-5 fw-bold text-white mb-0 mt-2">Support Queries</h1>
            <p class="text-muted mt-2 fs-5">Track your submitted tickets and our responses.</p>
        </div>
        <div class="d-none d-md-flex align-items-center gap-3">
            <a asp-controller="Support" asp-action="CreateQuery" class="btn-inst btn-inst-primary shadow-lg">
                <i class="fa-solid fa-plus me-2"></i>New Ticket
            </a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger bg-danger bg-opacity-10 border border-danger border-opacity-25 text-danger rounded-3 p-4 mb-4 d-flex align-items-center">
            <i class="fa-solid fa-triangle-exclamation fs-4 me-3"></i> 
            <div>
                <h5 class="mb-1 fw-bold">Error Loading Data</h5>
                <p class="mb-0 fs-7">@Model.ErrorMessage</p>
            </div>
        </div>
    }

    @if (Model.Queries == null || !Model.Queries.Any())
    {
        <div class="text-center p-5 border border-secondary border-opacity-25 rounded-4 bg-dark bg-opacity-25 mt-4">
            <i class="fa-solid fa-ticket fa-4x text-muted mb-3 opacity-50"></i>
            <h3 class="text-white">No Tickets Found</h3>
            <p class="text-muted mb-4">You have not submitted any support tickets yet.</p>
            <a asp-controller="Support" asp-action="CreateQuery" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm" style="background: linear-gradient(135deg, var(--primary), var(--secondary)); border: none;">
                Create Support Query <i class="fa-solid fa-arrow-right ms-2"></i>
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model.Queries)
            {
                var statusClass = item.Status?.ToLower() switch
                {
                    "pending" => "bg-warning-subtle text-warning border-warning-subtle",
                    "inprogress" => "bg-info-subtle text-info border-info-subtle",
                    "resolved" => "bg-success-subtle text-success border-success-subtle",
                    _ => "bg-secondary-subtle text-secondary border-secondary-subtle"
                };
                
                var statusIcon = item.Status?.ToLower() switch
                {
                    "pending" => "fa-clock",
                    "inprogress" => "fa-spinner fa-spin",
                    "resolved" => "fa-check-circle",
                    _ => "fa-circle-dot"
                };

                <div class="col-12">
                    <div class="panel-card p-4 border border-secondary border-opacity-25 rounded-4 position-relative group overflow-hidden">
                        
                        <div class="d-flex justify-content-between align-items-start mb-4">
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span class="badge bg-dark border border-secondary border-opacity-25 text-muted font-monospace fs-7 px-3 py-1">
                                        <i class="fa-solid fa-hashtag me-1 text-primary"></i>@item.TicketNumber
                                    </span>
                                </div>
                                <h3 class="text-white fw-bold mb-0 fs-4">@item.Subject</h3>
                            </div>
                            <span class="badge @statusClass border rounded-pill px-3 py-2 text-uppercase tracking-wider fs-7">
                                <i class="fa-solid @statusIcon me-1"></i> @item.Status
                            </span>
                        </div>

                        <div class="p-3 bg-dark bg-opacity-25 rounded-3 border border-secondary border-opacity-25 mb-4">
                            <p class="text-muted mb-0 fs-6 line-clamp-2">@item.Description</p>
                        </div>

                        <div class="row g-3">
                            <div class="col-sm-6 col-md-3">
                                <p class="text-muted text-uppercase tracking-wider fs-8 fw-bold mb-1">Created At</p>
                                <p class="text-white fw-medium mb-0 fs-7"><i class="fa-regular fa-calendar text-muted me-1"></i> @item.CreatedAt</p>
                            </div>

                            <div class="col-sm-6 col-md-3">
                                <p class="text-muted text-uppercase tracking-wider fs-8 fw-bold mb-1">Resolved At</p>
                                <p class="text-white fw-medium mb-0 fs-7">
                                    @if (item.ResolvedAt != null)
                                    {
                                        <span><i class="fa-regular fa-calendar-check text-success me-1"></i> @item.ResolvedAt</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic">Pending...</span>
                                    }
                                </p>
                            </div>

                            <div class="col-sm-6 col-md-3">
                                <p class="text-muted text-uppercase tracking-wider fs-8 fw-bold mb-1">Attachment</p>
                                <div class="mb-0 fs-7">
                                    @if (!string.IsNullOrWhiteSpace(item.AttachmentUrl))
                                    {
                                        <a href="@(item.AttachmentUrl)" target="_blank" class="text-info text-decoration-none hover-accent">
                                            <i class="fa-solid fa-paperclip me-1"></i> View File
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic">None</span>
                                    }
                                </div>
                            </div>
                            
                            <div class="col-sm-6 col-md-3">
                                <p class="text-muted text-uppercase tracking-wider fs-8 fw-bold mb-1">Admin Response</p>
                                <p class="text-white fw-medium mb-0 fs-7 line-clamp-2">
                                    @if (!string.IsNullOrWhiteSpace(item.AdminResponse))
                                    {
                                        <i class="fa-solid fa-reply text-primary me-1"></i> @item.AdminResponse
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic">Awaiting response...</span>
                                    }
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</section>

@section Scripts {
    <style>
        .fade-in-up {
            opacity: 0;
            transform: translateY(20px);
            animation: fadeInUp 0.8s ease-out forwards;
        }
        @@keyframes fadeInUp {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        .fs-7 { font-size: 0.85rem; }
        .fs-8 { font-size: 0.75rem; }
        .tracking-wider { letter-spacing: 1px; }
        
        .line-clamp-2 {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;  
            overflow: hidden;
        }
        
        .hover-accent:hover {
            color: var(--accent) !important;
        }
        
        .group {
            transition: all 0.3s ease;
        }
        .group:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
            border-color: rgba(59, 130, 246, 0.3) !important;
        }
    </style>
}