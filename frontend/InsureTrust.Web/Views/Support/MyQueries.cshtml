@model InsureTrust.Web.Models.SupportQueryListViewModel

@{
    ViewData["Title"] = "My Support Queries";
}

<section class="brut-container">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <span class="badge-brut badge-brut-primary mb-2">HELP CENTER</span>
            <h1 class="mb-0">Support Queries</h1>
            <p class="text-muted fw-bold">Track your submitted tickets and our responses.</p>
        </div>
        <a asp-controller="Support" asp-action="CreateQuery" class="btn-inst btn-inst-primary">
            <i class="fa-solid fa-plus me-2"></i> NEW TICKET
        </a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="brut-card border-danger bg-danger bg-opacity-10 mb-4 d-flex align-items-center">
            <i class="fa-solid fa-triangle-exclamation fs-3 me-3 text-danger"></i> 
            <div>
                <h4 class="mb-1 text-danger">Error Loading Data</h4>
                <p class="mb-0 fw-bold">@Model.ErrorMessage</p>
                <p class="small mt-1 text-muted">Please ensure the <strong>QueryService</strong> is running and reachable via the Gateway Hub.</p>
            </div>
        </div>
    }

    @if (Model.Queries == null || !Model.Queries.Any())
    {
        <div class="brut-card text-center py-5">
            <i class="fa-solid fa-ticket fa-4x mb-4 opacity-20"></i>
            <h3>No Tickets Found</h3>
            <p class="text-muted mb-4 fw-bold">You have not submitted any support tickets yet.</p>
            <a asp-controller="Support" asp-action="CreateQuery" class="btn-inst btn-inst-secondary">
                CREATE SUPPORT QUERY <i class="fa-solid fa-arrow-right ms-2"></i>
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model.Queries)
            {
                <div class="col-12">
                    <div class="brut-card">
                        <div class="d-flex justify-content-between align-items-start mb-4">
                            <div>
                                <span class="badge-brut mb-2">#@item.TicketNumber</span>
                                <h3 class="mb-0">@item.Subject</h3>
                            </div>
                            <span class="badge-brut @(item.Status?.ToLower() == "resolved" ? "badge-brut-primary" : "bg-white")">
                                @item.Status
                            </span>
                        </div>

                        <div class="brut-card bg-light bg-opacity-50 p-3 mb-4 shadow-none border-1">
                            <p class="mb-0 fw-bold">@item.Description</p>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="small fw-bold text-uppercase opacity-50">Created At</label>
                                <p class="fw-bold mb-0">@item.CreatedAt</p>
                            </div>
                            <div class="col-md-3">
                                <label class="small fw-bold text-uppercase opacity-50">Attachment</label>
                                <div>
                                    @if (!string.IsNullOrWhiteSpace(item.AttachmentUrl))
                                    {
                                        <a href="@(item.AttachmentUrl)" target="_blank" class="text-secondary fw-bold">
                                            <i class="fa-solid fa-paperclip me-1"></i> VIEW FILE
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">None</span>
                                    }
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="small fw-bold text-uppercase opacity-50">Admin Response</label>
                                <p class="fw-bold mb-0">
                                    @if (!string.IsNullOrWhiteSpace(item.AdminResponse))
                                    {
                                        <span class="text-secondary">@item.AdminResponse</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted italic">Awaiting response...</span>
                                    }
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</section>

@section Scripts {
    <style>
        .fade-in-up {
            opacity: 0;
            transform: translateY(20px);
            animation: fadeInUp 0.8s ease-out forwards;
        }
        @@keyframes fadeInUp {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        .fs-7 { font-size: 0.85rem; }
        .fs-8 { font-size: 0.75rem; }
        .tracking-wider { letter-spacing: 1px; }
        
        .line-clamp-2 {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;  
            overflow: hidden;
        }
        
        .hover-accent:hover {
            color: var(--accent) !important;
        }
        
        .group {
            transition: all 0.3s ease;
        }
        .group:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
            border-color: rgba(59, 130, 246, 0.3) !important;
        }
    </style>
}