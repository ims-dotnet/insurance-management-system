@model InsureTrust.Web.Models.SupportQueryListViewModel

@{
    ViewData["Title"] = "Manage Support Queries";
}

<section class="fade-in-up">
    <div class="page-heading d-flex justify-content-between align-items-center mb-5">
        <div>
            <span class="meta-line"><i class="fa-solid fa-user-shield me-1"></i> Admin Central</span>
            <h1 class="display-5 fw-bold text-white mb-0 mt-2">Support Desk</h1>
            <p class="text-muted mt-2 fs-5">Review and manage all customer support inquiries.</p>
        </div>
        <div class="d-flex gap-3">
            <div class="p-3 bg-dark bg-opacity-50 border border-secondary border-opacity-25 rounded-4 text-center">
                <p class="text-muted text-uppercase tracking-wider fs-8 fw-bold mb-1">Total</p>
                <h3 class="text-white fw-bold mb-0">@(Model.Queries?.Count ?? 0)</h3>
            </div>
            <div class="p-3 bg-warning bg-opacity-10 border border-warning border-opacity-25 rounded-4 text-center">
                <p class="text-warning text-opacity-75 text-uppercase tracking-wider fs-8 fw-bold mb-1">Pending</p>
                <h3 class="text-warning fw-bold mb-0">@(Model.Queries?.Count(q => q.Status == "Pending") ?? 0)</h3>
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success bg-success bg-opacity-10 border border-success border-opacity-25 text-success rounded-3 p-3 mb-4 d-flex align-items-center">
            <i class="fa-solid fa-circle-check fs-5 me-2"></i> @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null || !string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger bg-danger bg-opacity-10 border border-danger border-opacity-25 text-danger rounded-3 p-3 mb-4 d-flex align-items-center">
            <i class="fa-solid fa-triangle-exclamation fs-5 me-2"></i> @(TempData["Error"] ?? Model.ErrorMessage)
        </div>
    }

    @if (Model.Queries == null || !Model.Queries.Any())
    {
        <div class="text-center p-5 border border-secondary border-opacity-25 rounded-4 bg-dark bg-opacity-25 mt-4">
            <i class="fa-solid fa-clipboard-check fa-4x text-success mb-3 opacity-50"></i>
            <h3 class="text-white">All Caught Up!</h3>
            <p class="text-muted">There are no support queries in the system.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model.Queries.OrderByDescending(q => q.CreatedAt))
            {
                var statusClass = item.Status?.ToLower() switch
                {
                    "pending" => "bg-warning-subtle text-warning border-warning-subtle",
                    "inprogress" => "bg-info-subtle text-info border-info-subtle",
                    "resolved" => "bg-success-subtle text-success border-success-subtle",
                    _ => "bg-secondary-subtle text-secondary border-secondary-subtle"
                };
                
                var statusIcon = item.Status?.ToLower() switch
                {
                    "pending" => "fa-clock",
                    "inprogress" => "fa-spinner fa-spin",
                    "resolved" => "fa-check-circle",
                    _ => "fa-circle-dot"
                };

                <div class="col-12">
                    <div class="panel-card p-0 border border-secondary border-opacity-25 rounded-4 overflow-hidden group">
                        <div class="p-4 bg-dark bg-opacity-50 border-bottom border-secondary border-opacity-25 d-flex justify-content-between align-items-start">
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-primary bg-opacity-25 text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                                    <i class="fa-solid fa-user fs-5"></i>
                                </div>
                                <div>
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <h5 class="text-white fw-bold mb-0">User ID: @item.UserId</h5>
                                        <span class="badge bg-dark border border-secondary border-opacity-25 text-muted font-monospace fs-8 px-2 py-1">
                                            <i class="fa-solid fa-hashtag me-1 text-primary"></i>@item.TicketNumber
                                        </span>
                                    </div>
                                    <p class="text-muted fs-7 mb-0"><i class="fa-regular fa-clock me-1"></i> @item.CreatedAt.ToString("MMM dd, yyyy HH:mm")</p>
                                </div>
                            </div>
                            <span class="badge @statusClass border rounded-pill px-3 py-2 text-uppercase tracking-wider fs-7">
                                <i class="fa-solid @statusIcon me-1"></i> @item.Status
                            </span>
                        </div>

                        <div class="p-4">
                            <h4 class="text-white fw-bold mb-3 fs-5">@item.Subject</h4>
                            <div class="p-3 bg-dark bg-opacity-25 rounded-3 border border-secondary border-opacity-25 border-start border-start-4 border-primary mb-4">
                                <p class="text-muted mb-0 fs-6">@item.Description</p>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(item.AttachmentUrl))
                            {
                                <div class="mb-4">
                                    <a href="@(item.AttachmentUrl)" target="_blank" class="btn btn-sm btn-outline-info rounded-pill px-3 py-2">
                                        <i class="fa-solid fa-paperclip me-2"></i>View Attachment
                                    </a>
                                </div>
                            }

                            <div class="bg-dark bg-opacity-50 rounded-4 p-4 border border-secondary border-opacity-25">
                                <h5 class="text-white fs-6 fw-bold mb-3"><i class="fa-solid fa-reply text-primary me-2"></i>Admin Response</h5>
                                <form asp-action="UpdateStatus" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="Id" value="@item.Id" />
                                    
                                    <div class="row g-3 align-items-end">
                                        <div class="col-md-3 form-group mb-0">
                                            <label class="form-label text-muted fw-bold text-uppercase fs-8 tracking-wider mb-2">Update Status</label>
                                            <select name="Status" class="form-select bg-dark border-secondary border-opacity-50 text-white shadow-none">
                                                <option value="Pending" selected="@(item.Status == "Pending")">Pending</option>
                                                <option value="InProgress" selected="@(item.Status == "InProgress")">In Progress</option>
                                                <option value="Resolved" selected="@(item.Status == "Resolved")">Resolved</option>
                                            </select>
                                        </div>
                                        <div class="col-md-7 form-group mb-0">
                                            <label class="form-label text-muted fw-bold text-uppercase fs-8 tracking-wider mb-2">Message</label>
                                            <textarea name="AdminResponse" class="form-control bg-dark border-secondary border-opacity-50 text-white shadow-none" rows="1" placeholder="Provide suggestion or feedback...">@item.AdminResponse</textarea>
                                        </div>
                                        <div class="col-md-2">
                                            <button type="submit" class="btn btn-primary w-100 fw-bold rounded-3 shadow-lg" style="background: linear-gradient(135deg, var(--primary), var(--secondary)); border: none;">
                                                Update
                                            </button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</section>

@section Scripts {
    <style>
        .fade-in-up {
            opacity: 0;
            transform: translateY(20px);
            animation: fadeInUp 0.8s ease-out forwards;
        }
        @@keyframes fadeInUp {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        .fs-7 { font-size: 0.85rem; }
        .fs-8 { font-size: 0.75rem; }
        .tracking-wider { letter-spacing: 1px; }
        
        .border-start-4 {
            border-left-width: 4px !important;
        }
        
        .form-control:focus, .form-select:focus {
            background-color: rgba(15, 23, 42, 0.8) !important;
            border-color: var(--primary) !important;
            box-shadow: none !important;
        }
        
        .group {
            transition: all 0.3s ease;
        }
        .group:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
            border-color: rgba(59, 130, 246, 0.3) !important;
        }
    </style>
}
