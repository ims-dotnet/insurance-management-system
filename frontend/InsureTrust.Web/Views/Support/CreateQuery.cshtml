@model InsureTrust.Web.Models.CreateSupportQueryViewModel

@{
    ViewData["Title"] = "Create Support Query";
}

<section class="brut-container">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <span class="badge-brut badge-brut-primary mb-2">HELP CENTER</span>
            <h1 class="mb-0">New Support Ticket</h1>
            <p class="text-muted fw-bold">Raise an issue related to payments, policies, or account.</p>
        </div>
        <a asp-controller="Support" asp-action="MyQueries" class="btn-inst btn-inst-secondary">
            <i class="fa-solid fa-clock-rotate-left me-2"></i> HISTORY
        </a>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="brut-card p-0 overflow-hidden">
                <div class="p-4 bg-black text-white">
                    <h3 class="mb-0 text-white"><i class="fa-solid fa-pen-to-square me-2 text-primary"></i> Query Details</h3>
                </div>
                
                <div class="p-4">
                    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
                    {
                        <div class="brut-card bg-success bg-opacity-10 border-success mb-4 d-flex align-items-center">
                            <i class="fa-solid fa-circle-check fs-4 me-2 text-success"></i> 
                            <span class="fw-bold text-success">@Model.SuccessMessage</span>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                    {
                        <div class="brut-card bg-danger bg-opacity-10 border-danger mb-4 d-flex align-items-center">
                            <i class="fa-solid fa-triangle-exclamation fs-4 me-2 text-danger"></i> 
                            <div>
                                <strong class="text-danger">Error:</strong> @Model.ErrorMessage
                            </div>
                        </div>
                    }

                    <form asp-action="CreateQuery" asp-controller="Support" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()

                        <div class="form-group mb-4">
                            <label asp-for="Subject" class="form-label fw-bold text-uppercase">Subject Line</label>
                            <input asp-for="Subject" class="form-control-inst" placeholder="E.g., Payment completed but policy not active" />
                            <span asp-validation-for="Subject" class="text-danger fw-bold small mt-1 d-block"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="Description" class="form-label fw-bold text-uppercase">Detailed Description</label>
                            <textarea asp-for="Description" class="form-control-inst" rows="6" placeholder="Please describe your issue in detail..."></textarea>
                            <span asp-validation-for="Description" class="text-danger fw-bold small mt-1 d-block"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="Attachment" class="form-label fw-bold text-uppercase">Supporting Document (Optional)</label>
                            <input asp-for="Attachment" class="form-control-inst" type="file" />
                            <p class="small fw-bold text-muted mt-2">Accepted formats: PDF, JPG, PNG</p>
                            <span asp-validation-for="Attachment" class="text-danger fw-bold small mt-1 d-block"></span>
                        </div>

                        <div class="text-end mt-4">
                            <button type="submit" class="btn-inst btn-inst-primary w-100 py-3">
                                SUBMIT TICKET <i class="fa-solid fa-paper-plane ms-2"></i>
                            </button>
                        </div>
                    </form>

                    @if (Model.CreatedTicket != null)
                    {
                        <div class="mt-5 brut-card bg-success bg-opacity-5 border-success">
                            <h3 class="text-success mb-4"><i class="fa-solid fa-check-circle me-2"></i> TICKET CREATED</h3>
                            <div class="row g-3">
                                <div class="col-sm-6">
                                    <label class="small fw-bold text-uppercase opacity-50">Ticket Number</label>
                                    <p class="h4 fw-900">#@Model.CreatedTicket.TicketNumber</p>
                                </div>
                                <div class="col-sm-6">
                                    <label class="small fw-bold text-uppercase opacity-50">Status</label>
                                    <p><span class="badge-brut badge-brut-primary">@Model.CreatedTicket.Status</span></p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="brut-card bg-primary bg-opacity-10">
                <h3 class="fs-5 mb-4"><i class="fa-solid fa-lightbulb me-2"></i> COMMON ISSUES</h3>
                <ul class="list-unstyled fw-bold small d-flex flex-column gap-3">
                    <li class="d-flex align-items-start gap-2">
                        <i class="fa-solid fa-circle-arrow-right mt-1"></i>
                        <span>Payment completed but policy not updated</span>
                    </li>
                    <li class="d-flex align-items-start gap-2">
                        <i class="fa-solid fa-circle-arrow-right mt-1"></i>
                        <span>Renewal issue or wrong calculation</span>
                    </li>
                    <li class="d-flex align-items-start gap-2">
                        <i class="fa-solid fa-circle-arrow-right mt-1"></i>
                        <span>Claim upload or document issue</span>
                    </li>
                </ul>
            </div>

            <div class="brut-card mt-4 bg-secondary bg-opacity-10">
                <h3 class="fs-5 mb-3"><i class="fa-solid fa-paperclip me-2 text-secondary"></i> ATTACHMENTS</h3>
                <p class="small fw-bold mb-0">
                    Including a screenshot of an error message significantly speeds up the resolution process.
                </p>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <style>
        .fade-in-up {
            opacity: 0;
            transform: translateY(20px);
            animation: fadeInUp 0.8s ease-out forwards;
        }
        @@keyframes fadeInUp {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        .fs-7 { font-size: 0.85rem; }
        .fs-8 { font-size: 0.75rem; }
        .tracking-wider { letter-spacing: 1px; }
        
        .form-control:focus {
            background-color: rgba(15, 23, 42, 0.8) !important;
            border-color: var(--primary) !important;
        }
        
        .hover-bg-dark:hover {
            background-color: rgba(255,255,255,0.05);
        }
    </style>
}