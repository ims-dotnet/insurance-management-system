@model RegisterViewModel
@{
    ViewData["Title"] = "Create Account";
}

<div class="d-flex align-items-center justify-content-center min-vh-100 py-5">
    <section class="auth-card fade-in-up" style="max-width: 600px;">
        <div class="auth-badge mx-auto mb-3">
            <i class="fa-solid fa-user-plus"></i>
        </div>
        <h1 class="auth-title text-center text-white mb-2">Create Account</h1>
        <p class="auth-subtitle text-center text-muted mb-4 pb-2">Join InsureTrust and secure your future</p>

        <form id="registerForm" asp-controller="Account" asp-action="Register" method="post" enctype="multipart/form-data" novalidate class="auth-form">
            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
            {
                <div class="alert alert-danger bg-danger bg-opacity-10 border border-danger border-opacity-25 text-danger rounded-3 p-3 mb-4 fs-7">
                    <div asp-validation-summary="All" class="mb-0"></div>
                </div>
            }

            <div class="row g-3">
                <div class="col-md-6 form-group mb-3">
                    <label class="form-label text-muted fw-bold text-uppercase fs-7 tracking-wider" asp-for="Name">Full Legal Name</label>
                    <div class="input-group">
                        <span class="input-group-text bg-dark bg-opacity-50 border-secondary border-opacity-25 text-muted border-end-0 rounded-start-3">
                            <i class="fa-solid fa-user"></i>
                        </span>
                        <input asp-for="Name" class="form-control bg-dark bg-opacity-50 border-secondary border-opacity-25 text-white border-start-0 rounded-end-3 py-2 shadow-none" placeholder="John Doe" required />
                    </div>
                </div>

                <div class="col-md-6 form-group mb-3">
                    <label class="form-label text-muted fw-bold text-uppercase fs-7 tracking-wider" asp-for="Email">Email Address</label>
                    <div class="input-group">
                        <span class="input-group-text bg-dark bg-opacity-50 border-secondary border-opacity-25 text-muted border-end-0 rounded-start-3">
                            <i class="fa-solid fa-envelope"></i>
                        </span>
                        <input asp-for="Email" class="form-control bg-dark bg-opacity-50 border-secondary border-opacity-25 text-white border-start-0 rounded-end-3 py-2 shadow-none" type="email" placeholder="name@example.com" required />
                    </div>
                </div>

                <div class="col-md-6 form-group mb-3">
                    <label class="form-label text-muted fw-bold text-uppercase fs-7 tracking-wider" asp-for="PhoneNo">Phone Number</label>
                    <div class="input-group">
                        <span class="input-group-text bg-dark bg-opacity-50 border-secondary border-opacity-25 text-muted border-end-0 rounded-start-3">
                            <i class="fa-solid fa-phone"></i>
                        </span>
                        <input asp-for="PhoneNo" class="form-control bg-dark bg-opacity-50 border-secondary border-opacity-25 text-white border-start-0 rounded-end-3 py-2 shadow-none" placeholder="+1 (555) 000-0000" required />
                    </div>
                </div>

                <div class="col-md-6 form-group mb-3">
                    <label class="form-label text-muted fw-bold text-uppercase fs-7 tracking-wider" asp-for="PanCard">PAN Number</label>
                    <div class="input-group">
                        <span class="input-group-text bg-dark bg-opacity-50 border-secondary border-opacity-25 text-muted border-end-0 rounded-start-3">
                            <i class="fa-solid fa-id-card"></i>
                        </span>
                        <input asp-for="PanCard" class="form-control bg-dark bg-opacity-50 border-secondary border-opacity-25 text-white border-start-0 rounded-end-3 py-2 shadow-none" placeholder="ABCDE1234F" required />
                    </div>
                </div>

                <div class="col-md-6 form-group mb-4">
                    <label class="form-label text-muted fw-bold text-uppercase fs-7 tracking-wider" asp-for="Password">Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-dark bg-opacity-50 border-secondary border-opacity-25 text-muted border-end-0 rounded-start-3">
                            <i class="fa-solid fa-lock"></i>
                        </span>
                        <input asp-for="Password" class="form-control bg-dark bg-opacity-50 border-secondary border-opacity-25 text-white border-start-0 rounded-end-3 py-2 shadow-none" type="password" placeholder="••••••••" required />
                    </div>
                </div>

                <div class="col-md-6 form-group mb-4">
                    <label class="form-label text-muted fw-bold text-uppercase fs-7 tracking-wider" asp-for="ConfirmPassword">Confirm Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-dark bg-opacity-50 border-secondary border-opacity-25 text-muted border-end-0 rounded-start-3">
                            <i class="fa-solid fa-shield-check"></i>
                        </span>
                        <input asp-for="ConfirmPassword" class="form-control bg-dark bg-opacity-50 border-secondary border-opacity-25 text-white border-start-0 rounded-end-3 py-2 shadow-none" type="password" placeholder="••••••••" required />
                    </div>
                </div>
            </div>

            <p id="registerMessage" class="meta-note d-none"></p>

            <div class="d-flex flex-column gap-3 mt-2">
                <button type="submit" class="btn btn-primary w-100 py-3 rounded-pill fw-bold shadow-lg" style="background: linear-gradient(135deg, var(--primary), var(--secondary)); border: none;">
                    Create Account <i class="fa-solid fa-arrow-right ms-2"></i>
                </button>
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary w-100 py-3 rounded-pill fw-bold text-white border-secondary border-opacity-25 hover-bg-dark">
                    Already have an account? Sign In
                </a>
            </div>
        </form>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <style>
        .min-vh-100 {
            min-height: calc(100vh - var(--header-height));
            margin-top: calc(var(--header-height) * -1); 
        }
        .fade-in-up {
            opacity: 0;
            transform: translateY(20px);
            animation: fadeInUp 0.8s ease-out forwards;
        }
        @@keyframes fadeInUp {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        .fs-7 { font-size: 0.85rem; }
        .tracking-wider { letter-spacing: 1px; }
        
        .form-control:focus, .form-select:focus {
            background-color: rgba(15, 23, 42, 0.8) !important;
            border-color: var(--primary) !important;
            box-shadow: none !important;
        }
        
        .hover-bg-dark:hover {
            background-color: rgba(255,255,255,0.05);
        }
        
        .auth-card {
            margin: 0 !important;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
    </style>
}
