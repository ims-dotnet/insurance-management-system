@model InsureTrust.Web.Models.LoginViewModel
@{
    ViewData["Title"] = "Validate and Enter";
}

<section class="auth-card">
    <div class="auth-badge">✓</div>
    <h1 class="auth-title">Insure Trust</h1>
    <p class="auth-subtitle">Secure Login</p>

    <form asp-action="Login" method="post" class="auth-form" novalidate>
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        
        <div class="form-group">
            <label class="form-label" asp-for="LoginMode">Login Type</label>
            <select asp-for="LoginMode" class="form-control-inst">
                <option value="user">User</option>
                <option value="admin">Admin</option>
            </select>
        </div>
        <div class="form-group">
            <label class="form-label" asp-for="Email">Email</label>
            <input asp-for="Email" class="form-control-inst" type="email" required />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label class="form-label" asp-for="Password">Password</label>
            <input asp-for="Password" class="form-control-inst" type="password" required />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="auth-row">
            <label class="checkbox-label">
                <input asp-for="RememberMe" type="checkbox" /> Remember me
            </label>
            <a asp-controller="Account" asp-action="ForgotPassword" class="meta-link">Forgot password?</a>
        </div>

        <p id="loginMessage" class="meta-note"></p>

        <button type="submit" class="btn-inst btn-inst-success w-100">Login</button>
        <a asp-controller="Account" asp-action="Register" class="btn-inst w-100 mt-2 text-center">Create Account</a>
    </form>
</section>
