@{
    ViewData["Title"] = "Forgot Password";
}

<section class="auth-card">
    <div class="auth-badge">✉</div>
    <h1 class="auth-title">Password Recovery</h1>
    <p class="auth-subtitle">Enter your account email to receive reset instructions.</p>
    <div class="auth-avatar-strip">
        <img src="~/images/avatars/avatar-1.svg" alt="Avatar 1" />
        <img src="~/images/avatars/avatar-2.svg" alt="Avatar 2" />
        <img src="~/images/avatars/avatar-3.svg" alt="Avatar 3" />
        <img src="~/images/avatars/avatar-4.svg" alt="Avatar 4" />
        <img src="~/images/avatars/avatar-5.svg" alt="Avatar 5" />
    </div>

    <form id="forgotPasswordForm" class="auth-form" novalidate>
        <div class="form-group">
            <label class="form-label" for="recoveryEmail">Email</label>
            <input id="recoveryEmail" class="form-control-inst" type="email" required />
        </div>

        <p id="forgotPasswordMessage" class="meta-note"></p>

        <button type="submit" class="btn-inst btn-inst-success w-100">Send Recovery Email</button>
        <a asp-controller="Account" asp-action="Login" class="btn-inst w-100 mt-2 text-center">Back to Login</a>
    </form>
</section>
