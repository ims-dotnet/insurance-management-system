@using InsureTrust.Web.Services
@model UpdateProfileViewModel
@{
    ViewData["Title"] = "User Profile";
}

<section class="profile-shell fade-in-up">
<div class="brut-page-header mb-5">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <span class="text-primary fw-900 text-uppercase" style="font-size: 0.65rem; letter-spacing: 2px;">Account Security</span>
            <h1 class="display-6 fw-900 text-white mb-0 mt-1" style="text-transform: uppercase; letter-spacing: -1px;">Your Profile</h1>
            <p class="text-white-50 mt-1 mb-0" style="font-size: 0.8rem;">Manage your personal information and preferences.</p>
        </div>
        <div class="d-flex gap-2">
             <div class="badge-brut">Verified Account</div>
        </div>
    </div>
</div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success bg-success bg-opacity-10 border border-success border-opacity-25 text-success rounded-3 p-3 mb-4 d-flex align-items-center">
            <i class="fa-solid fa-circle-check fs-5 me-2"></i> @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger bg-danger bg-opacity-10 border border-danger border-opacity-25 text-danger rounded-3 p-3 mb-4 d-flex align-items-center">
            <i class="fa-solid fa-triangle-exclamation fs-5 me-2"></i> @TempData["Error"]
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="brut-card h-100">
                <div class="p-4 bg-dark d-flex align-items-center gap-4 border-bottom border-black">
                    <div class="position-relative">
                        <img src="~/images/avatars/avatar-1.svg" alt="Profile" class="border border-3 border-primary" style="width: 80px; height: 80px; object-fit: cover;" onerror="this.src='https://ui-avatars.com/api/?name=User&background=FBBC05&color=000';" />
                        <button class="btn-brut-icon position-absolute bottom-0 end-0">
                            <i class="fa-solid fa-camera"></i>
                        </button>
                    </div>
                    <div>
                        <h3 class="text-white fw-900 mb-1" id="profileNameDisplay" style="text-transform: uppercase;">Loading...</h3>
                        <p class="text-white-50 mb-0 fs-7 d-flex align-items-center gap-2">
                            <i class="fa-solid fa-envelope text-primary"></i> <span id="profileEmailDisplay">--</span>
                        </p>
                    </div>
                </div>

                <div class="p-4 bg-white">
                    <h4 class="text-black fw-900 mb-4 fs-5 text-uppercase"><i class="fa-solid fa-address-card text-primary me-2"></i> Personal Details</h4>
                    
                    <div class="row g-3 mb-5">
                        <div class="col-sm-6">
                            <div class="p-3 bg-black text-white border-black">
                                <p class="text-primary text-uppercase tracking-wider fs-9 fw-900 mb-1">Direct Extension</p>
                                <p class="fw-bold mb-0 fs-6" id="profilePhoneDisplay">--</p>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="p-3 bg-black text-white border-black">
                                <p class="text-primary text-uppercase tracking-wider fs-9 fw-900 mb-1">Assigned Role</p>
                                <p class="fw-bold mb-0 fs-6">
                                    <span class="badge bg-primary text-black border-black rounded-0 px-3 py-1" id="profileRoleDisplay">--</span>
                                </p>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="p-3 bg-black text-white border-black">
                                <p class="text-primary text-uppercase tracking-wider fs-9 fw-900 mb-1">User Identifier</p>
                                <p class="fw-bold mb-0 fs-6 font-monospace" id="profileUserNumberDisplay">--</p>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="p-3 bg-black text-white border-black">
                                <p class="text-primary text-uppercase tracking-wider fs-9 fw-900 mb-1">Account Status</p>
                                <p class="fw-bold mb-0 fs-6">
                                    <span class="badge bg-success text-white border-black rounded-0 px-3 py-1"><i class="fa-solid fa-check-circle me-1"></i> Active</span>
                                </p>
                            </div>
                        </div>
                    </div>

                    <h4 class="text-black fw-900 mb-4 fs-5 text-uppercase"><i class="fa-solid fa-user-pen text-primary me-2"></i> Update Information</h4>
                    <form id="profileUpdateForm" asp-controller="Account" asp-action="Profile" method="post" enctype="multipart/form-data" novalidate>
                        <div class="row g-4">
                            <div class="col-md-6 form-group">
                                <label class="form-label text-black fw-900 text-uppercase fs-7 tracking-wider" asp-for="Name">Full Name</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-black text-white border-black rounded-0">
                                        <i class="fa-solid fa-user"></i>
                                    </span>
                                    <input asp-for="Name" class="form-control border-black rounded-0 py-2 shadow-none" style="font-weight: 600;" />
                                </div>
                            </div>
                            <div class="col-md-6 form-group">
                                <label class="form-label text-black fw-900 text-uppercase fs-7 tracking-wider" asp-for="PhoneNo">Phone Number</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-black text-white border-black rounded-0">
                                        <i class="fa-solid fa-phone"></i>
                                    </span>
                                    <input asp-for="PhoneNo" class="form-control border-black rounded-0 py-2 shadow-none" style="font-weight: 600;" />
                                </div>
                            </div>
                        </div>
                        <p id="profileMessage" class="meta-note mt-3 d-none"></p>
                        <div class="mt-4 text-end">
                            <button type="submit" class="btn-inst btn-inst-primary px-5 py-2">
                                SAVE CHANGES
                            </button>
                        </div>
                    </form>

                    <div class="mt-5 pt-4 border-top border-black border-2">
                        <h4 class="text-black fw-900 mb-4 fs-5 text-uppercase"><i class="fa-solid fa-file-shield text-primary me-2"></i> Your Policy Portfolio</h4>
                        
                        <div class="d-flex flex-column gap-2">
                            @{
                                var policies = ViewBag.UserPolicies as IEnumerable<PolicyDto>;
                            }
                            @if (policies != null && policies.Any())
                            {
                                @foreach (var p in policies)
                                {
                                    <div class="p-3 bg-white border border-black d-flex justify-content-between align-items-center">
                                        <div>
                                            <div class="d-flex align-items-center gap-2 mb-1">
                                                <h6 class="text-black mb-0 fw-900">@p.PolicyNumber</h6>
                                                <span class="badge bg-black text-white border-black rounded-0 fs-9">
                                                    @p.Status
                                                </span>
                                            </div>
                                            <p class="text-muted mb-0 fs-7 fw-bold">@p.PolicyTypeName — Expires @p.ExpiryDate.ToString("dd MMM yyyy")</p>
                                        </div>
                                        <a href="/Policy/GetAllPolicybyid" class="btn-inst py-1 px-3" style="font-size: 0.65rem;">DETAILS</a>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="p-4 text-center border-black border-2 border-dashed">
                                    <i class="fa-solid fa-folder-open text-muted fs-2 mb-2"></i>
                                    <p class="text-black fw-bold mb-0">No active policies found in your portfolio.</p>
                                    <a href="/Policy" class="btn-inst btn-inst-primary py-1 px-3 mt-3">BROWSE PLANS</a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="d-flex flex-column gap-4">
                <div class="brut-card p-0 overflow-hidden">
                    <div class="p-4 bg-black text-white">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h4 class="fw-900 mb-0 fs-5 text-uppercase"><i class="fa-solid fa-wallet text-primary me-2"></i> Wallet</h4>
                            <i class="fa-brands fa-cc-visa text-primary fs-3"></i>
                        </div>
                        <p class="text-primary text-uppercase tracking-wider fs-9 fw-900 mb-1">Available Balance</p>
                        <h2 class="display-5 fw-900 text-white mb-4" id="profileBalanceDisplay" style="letter-spacing: -2px;">₹0</h2>
                        <button type="button" class="btn-inst btn-inst-primary w-100">
                            <i class="fa-solid fa-money-bill-transfer me-2"></i> REQUEST PAYOUT
                        </button>
                    </div>
                </div>

                <div class="brut-card p-4 bg-white">
                    <h4 class="text-black fw-900 mb-4 fs-5 text-uppercase"><i class="fa-solid fa-calculator text-primary me-2"></i> Quick Estimate</h4>
                    <p class="text-muted fs-7 mb-4 fw-bold">Calculate premium rates for different policy configurations instantly.</p>
                    <div class="p-3 bg-black border-black">
                        @await Html.PartialAsync("_Calculator")
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        (function () {
            // Load profile data on page load
            fetch('/Account/ProfileData')
                .then(function (res) { return res.json(); })
                .then(function (json) {
                    if (json.success && json.data) {
                        var d = json.data;
                        var el = function (id) { return document.getElementById(id); };
                        
                        if (el('profileNameDisplay')) el('profileNameDisplay').textContent = d.name || 'Unknown User';
                        if (el('profileEmailDisplay')) el('profileEmailDisplay').textContent = d.email || 'No email provided';
                        if (el('profilePhoneDisplay')) el('profilePhoneDisplay').textContent = d.phoneNo || 'Not provided';
                        if (el('profileRoleDisplay')) el('profileRoleDisplay').textContent = d.role || 'User';
                        if (el('profileUserNumberDisplay')) el('profileUserNumberDisplay').textContent = d.userNumber || 'N/A';
                        
                        // Format balance
                        if (el('profileBalanceDisplay')) {
                            const formatter = new Intl.NumberFormat('en-IN', {
                                style: 'currency',
                                currency: 'INR',
                                maximumFractionDigits: 0
                            });
                            el('profileBalanceDisplay').textContent = formatter.format(d.balance || 0);
                        }
                    }
                })
                .catch(function () { /* silent */ });
        })();
    </script>
    <style>
        .fade-in-up {
            opacity: 0;
            transform: translateY(20px);
            animation: fadeInUp 0.8s ease-out forwards;
        }
        @@keyframes fadeInUp {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        .fs-7 { font-size: 0.85rem; }
        .fs-8 { font-size: 0.75rem; }
        .tracking-wider { letter-spacing: 1px; }
    </style>
}
