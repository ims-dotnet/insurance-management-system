@inject IConfiguration Configuration
@{
    var gatewayBase = Configuration["ApiBaseUrls:Gateway"] ?? string.Empty;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - InsureTrust</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/InsureTrust.Web.styles.css" asp-append-version="true" />
</head>
<body data-gateway-base="@gatewayBase">
    @{
        var isUserAdmin = User.IsInRole("Admin") || (ViewContext.RouteData.Values["controller"]?.ToString() == "Admin");
    }
    <div class="institutional-wrapper @(isUserAdmin ? "admin-mode" : "")">
        @if (!isUserAdmin)
        {
            <aside class="sidebar-left">
            <div class="sidebar-brand py-4">
                <div class="brand-name" style="font-size: 1.5rem;">InsureTrust</div>
                <div class="brand-subtitle" style="font-size: 0.75rem; letter-spacing: 1px;">MANAGEMENT CONSOLE</div>
            </div>

            @if (!(User.Identity?.IsAuthenticated ?? false))
            {
                <a asp-controller="Account" asp-action="Register" class="btn-inst btn-inst-primary w-100 text-center mb-4 py-2 fs-7">
                    <i class="fa-solid fa-user-plus"></i> Create Account
                </a>
            }
            else if (User.IsInRole("Admin"))
            {
                 <div class="alert alert-warning bg-warning bg-opacity-10 border-0 text-warning rounded-0 p-2 mb-4 fs-8 text-center fw-bold" style="border: 2px solid #fbbf24 !important;">
                    <i class="fa-solid fa-user-shield me-1"></i> ADMIN: @User.Identity.Name
                </div>
            }
            else
            {
                <div class="alert alert-info bg-primary bg-opacity-10 border-0 text-primary rounded-3 p-2 mb-3 fs-8 text-center">
                    <i class="fa-solid fa-circle-check me-1"></i> Connected as <strong>@User.Identity.Name</strong>
                </div>
            }

            <nav class="nav-ledger">
                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Admin" asp-action="Dashboard"><i class="fa-solid fa-gauge-high me-2"></i> Admin Dashboard</a>
                }
                else
                {
                    <a asp-controller="Home" asp-action="Index"><i class="fa-solid fa-chart-pie me-2"></i> Dashboard</a>
                }
                <a asp-controller="Policy" asp-action="GetAllPolicybyid" data-auth-required="true"><i class="fa-solid fa-shield-halved me-2"></i> Policy Desk</a>
                <a asp-controller="Claim" asp-action="Index" data-auth-required="true"><i class="fa-solid fa-file-invoice-dollar me-2"></i> Claim Desk</a>
                <a asp-controller="Notification" asp-action="Index" data-auth-required="true"><i class="fa-solid fa-bell me-2"></i> Notifications</a>
                <a asp-controller="Account" asp-action="Profile" data-auth-required="true"><i class="fa-solid fa-user me-2"></i> Profile</a>
                <button type="button" id="openCalculatorPanel" class="btn-link-ledger"><i class="fa-solid fa-calculator me-2"></i> Calculator</button>
            </nav>

            <div class="sidebar-footer">
                <a asp-controller="Support" asp-action="MyQueries" data-auth-required="true"><i class="fa-solid fa-headset me-2"></i> Support</a>
                <a asp-controller="Account" asp-action="Logout"><i class="fa-solid fa-arrow-right-from-bracket me-2"></i> Logout</a>
            </div>
            </aside>
        }

        <div class="main-stage">
            @if (isUserAdmin)
            {
                <nav class="admin-top-nav">
                    <div class="nav-left">
                        <div class="brand">
                            <i class="fa-solid fa-hexagon-nodes fs-5 text-warning"></i>
                            <span class="ms-2 fw-black tracking-wider" style="color: #ffffff !important; font-size: 1.2rem;">INSURE TRUST</span>
                        </div>
                    </div>
                    <div class="nav-center">
                        <a asp-controller="Admin" asp-action="Dashboard" class="nav-link-admin @(ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" || (ViewContext.RouteData.Values["action"]?.ToString() == "Index" && ViewContext.RouteData.Values["controller"]?.ToString() == "Admin") ? "active" : "")">DASHBOARD</a>
                        <a asp-controller="Admin" asp-action="Policies" class="nav-link-admin @(ViewContext.RouteData.Values["action"]?.ToString() == "Policies" || ViewContext.RouteData.Values["controller"]?.ToString() == "Policy" ? "active" : "")">POLICIES</a>
                        <a asp-controller="Admin" asp-action="Claims" class="nav-link-admin @(ViewContext.RouteData.Values["action"]?.ToString() == "Claims" ? "active" : "")">CLAIMS</a>
                        <a asp-controller="Admin" asp-action="Support" class="nav-link-admin @(ViewContext.RouteData.Values["action"]?.ToString() == "Support" ? "active" : "")">SUPPORT</a>
                    </div>
                    <div class="nav-right">
                        @await Html.PartialAsync("_NotificationBell")
                        <div class="admin-user-info ms-2">
                            <div class="initials-circle bg-warning text-dark fw-bold">
                                @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "A")@(User.Identity?.Name?.Contains(" ") == true ? User.Identity?.Name?.Split(' ')[1].Substring(0, 1).ToUpper() : "D")
                            </div>
                            <span class="admin-name text-white ms-2 fw-bold" style="font-size: 0.7rem; letter-spacing: 0.5px;">@User.Identity?.Name</span>
                        </div>
                        <a asp-controller="Account" asp-action="Logout" class="btn-signout ms-1">SIGN OUT</a>
                    </div>
                </nav>
            }
            else
            {
                <header class="main-header">
                    @await Html.PartialAsync("_NotificationBell")
                    <div class="header-user-profile">
                        <img id="sidebarUserAvatar" class="header-avatar" src="~/images/avatars/avatar-1.svg" alt="User avatar" onerror="this.src='https://ui-avatars.com/api/?name=User&background=FBBC05&color=000';" />
                        <div class="user-details" style="@(User.Identity?.IsAuthenticated == true ? "display: block;" : "display: none;")">
                            <p id="sidebarUserName">@(User.Identity?.Name ?? "Guest User")</p>
                            <p id="sidebarUserEmail">@(User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "guest@insuretrust")</p>
                        </div>
                    </div>
                </header>
            }

            <main role="main" class="main-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <div id="calculatorPopup" class="calculator-popup" aria-hidden="true" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.5); z-index:9999; align-items:center; justify-content:center;">
        <div class="calculator-popup-panel" role="dialog" aria-modal="true" aria-label="Calculator" style="width: 100%; max-width: 500px;">
            <div class="calculator-popup-header d-flex justify-content-between align-items-center mb-3">
                <span class="fs-5 fw-bold text-white"><i class="fa-solid fa-calculator me-2 text-primary"></i> Quick Calculator</span>
                <button type="button" id="closeCalculatorPopup" class="btn btn-sm btn-outline-light rounded-circle" aria-label="Close calculator"><i class="fa-solid fa-xmark"></i></button>
            </div>
            @await Html.PartialAsync("_Calculator")
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // Calculator open/close is handled by site.js using the .open class.
        // This block is intentionally left minimal to avoid double-binding.
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>