                    <h3 style="font-family: var(--font-heading); font-size: 1.2rem; text-transform: none; margin-bottom: 0.5rem;">Account Number</h3>
                    <span style="font-size: 0.75rem; color: #a9a9a9; text-transform: uppercase;">PRIMARY LEDGER</span>
                    <input asp-for="AccountNumber" class="form-control-inst" style="margin-top: 0.5rem;" placeholder="Account No" />
                </div>

                <div style="margin-bottom: 2rem;">
                    <h3 style="font-family: var(--font-heading); font-size: 1.2rem; text-transform: none; margin-bottom: 0.5rem;">Routing / IFSC Code</h3>
                    <span style="font-size: 0.75rem; color: #a9a9a9; text-transform: uppercase;">BRANCH IDENTIFIER</span>
                    <input asp-for="IFSCCode" class="form-control-inst" style="margin-top: 0.5rem;" placeholder="IFSC Code" />
                </div>
            }

            <hr style="border: none; border-top: 2px solid var(--border-dark); margin: 2rem 0;" />

            <div style="text-align: center; margin-bottom: 2rem; font-size: 0.7rem; font-family: var(--font-sans); text-transform: uppercase; line-height: 1.5; font-weight: bold; max-width: 80%; margin-left: auto; margin-right: auto;">
                BY AFFIXING AUTHORIZATION BELOW, THE SIGNATORY CONFIRMS THE VALIDITY OF THE PROVIDED INSTRUMENT AND CONSENTS TO THE IMMEDIATE DEDUCTION OF REQUISITE FUNDS AS LOGGED IN THE INSTITUTIONAL LEDGER.
            </div>

            <div style="text-align: center;">
