@model InsureTrust.Web.Models.PolicyPaymentViewModel

@{
    ViewData["Title"] = "Finalize Renewal";
}

<style>
    @@media (max-width: 900px) {
        .renew-form-layout {
            flex-direction: column !important;
            gap: 2rem !important;
        }

        .renew-sidebar {
            width: 100% !important;
        }

        .renew-row {
            flex-direction: column !important;
            gap: 1rem !important;
        }
    }
</style>

<div class="institutional-wrapper" style="background-color: var(--bg-paper); padding: 2rem;">
    <div style="max-width: 1000px; margin: 0 auto; width: 100%;">

        <div style="display: flex; justify-content: space-between; align-items: baseline; border-bottom: 2px solid var(--border-dark); padding-bottom: 0.5rem; margin-bottom: 2rem;">
            <h4 style="color: var(--accent-red); margin: 0;">Secure Payment</h4>
            <span style="font-size: 0.75rem; text-transform: uppercase; font-family: var(--font-sans); letter-spacing: 1px;">Complete Your Policy Renewal</span>
        </div>

        <h1 style="font-size: 2.5rem; margin-bottom: 0.5rem;">Review & Confirm Your Payment Details</h1>
        <p style="color: var(--text-ink); font-family: var(--font-sans); margin-bottom: 3rem;">
            Please review your active policy reference and authorize the renewal payment.
        </p>

        <form asp-action="RenewPolicy" asp-controller="Renewal" method="post" class="renew-form-layout" style="display: flex; gap: 4rem;">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="IsRenewal" value="true" />
            <input type="hidden" asp-for="Amount" />

            <div style="flex: 1;">
                <h3 style="font-size: 1.1rem; letter-spacing: 1px;">POLICY DETAILS</h3>
                <hr class="divider-thick" style="margin-top: 0.5rem;" />

                <div class="renew-row" style="display: flex; gap: 2rem; margin-bottom: 1.5rem;">
                    <div style="flex: 1;">
                        <span class="form-label">POLICY NUMBER</span>
                        <input asp-for="PolicyNumber" class="form-control-inst" readonly style="background: transparent;" />
                    </div>

                    <div style="flex: 1;">
                        <span class="form-label">TRANSACTION TYPE</span>
                        <div style="padding: 0.5rem; font-family: var(--font-body); font-size: 0.9rem; border-bottom: 1px solid var(--border-dark);">
                            Policy Renewal
                        </div>
                    </div>
                </div>

                <div style="margin-bottom: 3rem;">
                    <span class="form-label">CHOOSE PAYMENT METHOD</span>
                    <select asp-for="PaymentCategory" class="form-control-inst" style="background: transparent; appearance: none; border-radius: 0;">
                        <option value="UPI">UPI Transfer</option>
                        <option value="Card">Credit / Debit Card</option>
                        <option value="NetBanking">Net Banking</option>
                    </select>
                </div>

                <h3 style="font-size: 1.1rem; letter-spacing: 1px;">SELECT PAYMENT OPTION</h3>
                <hr class="divider-thick" style="margin-top: 0.5rem;" />

                <div style="border: 1px solid var(--border-dark); padding: 1rem; margin-bottom: 1rem; background-color: rgba(200, 195, 181, 0.2);">
                    <strong style="display: block; font-family: var(--font-heading); text-transform: uppercase; margin-bottom: 0.5rem;">Payment Option Details</strong>
                    <select asp-for="PaymentMethod" class="form-control-inst" style="background-color: var(--bg-paper); border-bottom: 1px solid var(--border-dark); padding: 0.4rem 0.5rem; width: 100%;">
                        <option value="UPI">UPI</option>
                        <option value="GPay">GPay</option>
                        <option value="PhonePe">PhonePe</option>
                        <option value="Paytm">Paytm</option>
                        <option value="DebitCard">Debit Card</option>
                        <option value="CreditCard">Credit Card</option>
                        <option value="NetBanking">Net Banking</option>
                        <option value="PayPal">PayPal</option>
                    </select>
                </div>
            </div>

            <div class="renew-sidebar" style="width: 350px; border: 1px solid var(--border-dark); padding: 1.5rem; background-color: rgba(255,255,255,0.2);">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
                    <h3 style="margin: 0; font-size: 1.2rem; letter-spacing: 1px;">PAYMENT SUMMARY</h3>
                    <span style="font-size: 1.2rem;">&#128196;</span>
                </div>

                <table style="width: 100%; margin-bottom: 1.5rem; font-family: var(--font-sans); font-size: 0.85rem;">
                    <tbody>
                        <tr>
                            <td style="padding: 0.5rem 0; border-bottom: 1px solid var(--border-light); text-transform: uppercase;">Policy Number</td>
                            <td style="padding: 0.5rem 0; border-bottom: 1px solid var(--border-light); text-align: right; font-weight: bold;">@Model.PolicyNumber</td>
                        </tr>
                        <tr>
                            <td style="padding: 0.5rem 0; border-bottom: 1px solid var(--border-light); text-transform: uppercase;">Renewal</td>
                            <td style="padding: 0.5rem 0; border-bottom: 1px solid var(--border-light); text-align: right; font-weight: bold;">Yes</td>
                        </tr>
                    </tbody>
                </table>

                <table style="width: 100%; margin-bottom: 1rem; font-family: var(--font-sans); font-size: 0.85rem;">
                    <tbody>
                        <tr>
                            <td style="padding: 0.25rem 0;">Base Amount</td>
                            <td style="padding: 0.25rem 0; text-align: right;">₹@Model.Amount.ToString("N2")</td>
                        </tr>
                        <tr>
                            <td style="padding: 0.25rem 0;">Late Fee</td>
                            <td style="padding: 0.25rem 0; text-align: right;">Applied if expired</td>
                        </tr>
                    </tbody>
                </table>

                <hr class="divider-thick" />

                <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 1.5rem;">
                    <h2 style="margin: 0; font-size: 1.5rem; line-height: 1;">TOTAL<br /><span style="font-size: 1.2rem;">PAYABLE</span></h2>
                    <h2 style="margin: 0; font-size: 1.5rem;">₹@Model.Amount.ToString("N2")</h2>
                </div>

                <div style="display: flex; gap: 0.5rem; align-items: flex-start; margin-bottom: 1.5rem; font-family: var(--font-sans); font-size: 0.75rem;">
                    <input type="checkbox" required id="authorizeRenew" style="margin-top: 0.2rem; flex-shrink: 0; width: 16px; height: 16px; cursor: pointer;" />
                    <label for="authorizeRenew" style="cursor: pointer;">I confirm this renewal request and authorize this payment.</label>
                </div>

                <button type="submit" class="btn-inst btn-inst-primary" style="width: 100%; background-color: var(--accent-green); color: #fff; padding: 1rem; border: none;">
                    PROCEED TO PAY
                </button>
            </div>
        </form>

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div style="margin-top: 2rem; border: 1px solid var(--accent-red); padding: 1rem; background-color: rgba(139, 38, 38, 0.1); color: var(--accent-red); font-family: var(--font-sans);">
                <strong>Error:</strong> @Model.ErrorMessage
            </div>
        }
    </div>
</div>