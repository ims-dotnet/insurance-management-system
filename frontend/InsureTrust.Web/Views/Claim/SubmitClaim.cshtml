@model InsureTrust.Web.Models.SubmitClaimViewModel

@{
    ViewData["Title"] = "Submit a Claim";
}

<div style="margin-bottom: 2rem; margin-top: 1rem;">
    <h1 style="font-family: var(--font-heading); font-size: 3rem; margin-bottom: 1rem;">CLAIM SUBMISSION</h1>
    <div style="display: flex; justify-content: space-between; align-items: flex-end;">
        <p style="font-family: var(--font-heading); color: var(--text-main); margin: 0; max-width: 60%; font-size: 0.9rem;">
            Complete all sections below with absolute precision. Omissions will result in immediate rejection of the claim artifact.
        </p>
        <div style="text-align: right;">
            <div style="font-family: var(--font-heading); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 0.2rem;">FORM REF:</div>
            <div style="border: 2px solid var(--text-main); padding: 0.2rem 0.5rem; font-family: var(--font-heading); font-weight: bold; font-size: 1.1rem; display: inline-block;">
                CLM-402-A
            </div>
        </div>
    </div>
</div>

<hr style="border: 2px solid var(--text-main); margin-top: 0; margin-bottom: 1.5rem; opacity: 1;" />

<form asp-action="SubmitClaim" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    
    <div style="border: 3px solid var(--text-main); background-color: var(--bg-surface); box-shadow: 6px 6px 0px #000;">
        
        <!-- Section I -->
        <div style="border-bottom: 3px solid var(--text-main); padding: 1rem; background-color: var(--primary); font-family: var(--font-heading); font-size: 1.25rem; font-weight: 800; text-transform: uppercase;">
            I. INCIDENT PARTICULARS
        </div>
        
        <div style="display: flex; border-bottom: 1px solid var(--text-main);">
            <div style="flex: 1; border-right: 1px solid var(--text-main); padding: 1.5rem;">
                <label class="form-label fw-800" style="font-family: var(--font-heading); letter-spacing: 1px; font-size: 0.75rem;">POLICY IDENTIFICATION NUMBER</label>
                <select asp-for="PolicyId" class="form-select" style="border:2px solid #000; font-weight: 800; background-color: #fff;">
                    <option value="">-- SELECT POLICY --</option>
                    @if (ViewBag.ActivePolicies != null)
                    {
                        foreach (var policy in ViewBag.ActivePolicies)
                        {
                            <option value="@policy.Id">@policy.PolicyNumber - @policy.PolicyTypeName</option>
                        }
                    }
                </select>
                <span asp-validation-for="PolicyId" class="text-danger"></span>
            </div>
            <div style="flex: 1; border-right: 1px solid var(--text-main); padding: 1.5rem;">
                <label class="form-label fw-800" style="font-family: var(--font-heading); letter-spacing: 1px; font-size: 0.75rem;">DATE OF OCCURRENCE</label>
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <input type="date" class="form-control" style="border:2px solid #000; font-weight: 800;" />
                </div>
            </div>
            <div style="flex: 1; padding: 1.5rem;">
                <label class="form-label fw-800" style="font-family: var(--font-heading); letter-spacing: 1px; font-size: 0.75rem;">TIME OF OCCURRENCE</label>
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <input type="time" class="form-control" style="border:2px solid #000; font-weight: 800;" />
                </div>
            </div>
        </div>
        
        <div style="border-bottom: 1px solid var(--text-main); padding: 1.5rem;">
            <label class="form-label fw-800" style="font-family: var(--font-heading); letter-spacing: 1px; font-size: 0.75rem;">GEOGRAPHIC LOCATION OF INCIDENT</label>
            <input type="text" class="form-control" placeholder="Full legal address or precise coordinates" style="border:2px solid #000; font-weight: 800;" />
        </div>
        
        <div style="padding: 1rem; background-color: var(--bg-base); border-bottom: 1px solid var(--text-main);">
            <label class="form-label fw-800" style="font-family: var(--font-heading); letter-spacing: 1px; font-size: 0.75rem;">COMPREHENSIVE NARRATIVE DESCRIPTION</label>
        </div>
        <div style="padding: 1.5rem;">
            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Provide a detailed, chronological account of the events resulting in the claimed loss..." style="border:2px solid #000; font-weight: 600; resize: vertical;"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <!-- Section II -->
        <div style="border-bottom: 3px solid var(--text-main); border-top: 3px solid var(--text-main); padding: 1rem; background-color: var(--primary); font-family: var(--font-heading); font-size: 1.25rem; font-weight: 800; text-transform: uppercase;">
            II. LOSS ASSESSMENT
        </div>
        
        <div style="display: flex; border-bottom: 3px solid var(--text-main); background-color: #fff;">
            <div style="flex: 1; border-right: 3px solid var(--text-main); padding: 1.5rem; display: flex; flex-direction: column; justify-content: center;">
                <label asp-for="MaturityAmount" class="form-label fw-800" style="font-family: var(--font-heading); letter-spacing: 1px; font-size: 0.75rem;">CALCULATED MATURITY AMOUNT</label>
                <div style="display: flex; align-items: center; margin-top: 1rem;">
                    <span style="font-family: var(--font-heading); font-size: 2rem; font-weight: 900; margin-right: 1rem;">₹</span>
                    <input asp-for="MaturityAmount" type="number" step="0.01" class="form-control" placeholder="0.00" style="font-size: 2rem; text-align: right; font-family: var(--font-heading); font-weight: 900; border: 3px solid #000; background: var(--bg-base);" />
                </div>
                <span asp-validation-for="MaturityAmount" class="text-danger"></span>
            </div>
            <div style="flex: 1; padding: 1.5rem; background: var(--bg-base);">
                <div style="margin-bottom: 2rem;">
                    <label class="form-label fw-800" style="font-family: var(--font-heading); letter-spacing: 1px; font-size: 0.75rem;">CURRENCY DENOMINATION</label>
                    <select class="form-select" style="border:2px solid #000; font-weight: 800;">
                        <option>INR - INDIAN RUPEE</option>
                        <option>USD - UNITED STATES DOLLAR</option>
                    </select>
                </div>
                <div>
                    <label class="form-label fw-800" style="font-family: var(--font-heading); letter-spacing: 1px; font-size: 0.75rem;">LOSS CLASSIFICATION</label>
                    <select class="form-select" style="border:2px solid #000; font-weight: 800;">
                        <option>PROPERTY DAMAGE (STRUCTURAL)</option>
                        <option>ACCIDENTAL LOSS</option>
                        <option>MEDICAL EMERGENCY</option>
                    </select>
                </div>
            </div>
        </div>

    </div>
    
    <div style="margin-top: 2rem; text-align: right;">
        <button type="submit" class="btn-inst" style="background-color: #000; color: #fff; padding: 1rem 3rem; font-size: 1.25rem; border: 4px solid #000; box-shadow: 6px 6px 0px var(--primary); font-weight: 900;">FILE CLAIM</button>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
