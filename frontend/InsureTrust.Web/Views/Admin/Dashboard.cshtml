@model InsureTrust.Web.Models.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
    var totalCustomers = Model.Stats.TotalUsers;
    var totalPolicies = Model.Stats.TotalActivePolicies + Model.Stats.TotalPendingPolicies;
    var pendingApprovals = Model.Stats.TotalPendingPolicies;
    var openTickets = Model.Stats.TotalOpenSupportTickets;
    var totalClaims = Model.Stats.TotalPendingClaims;
}

<section class="admin-dashboard-reference fade-in-up">
    <div class="page-heading d-flex justify-content-between align-items-center mb-4">
        <div>
            <span class="meta-line fs-8 py-1 px-2"><i class="fa-solid fa-user-shield me-1"></i> ADMIN CONSOLE</span>
            <h1 class="fw-bold text-dark mb-0 mt-2" style="font-size: 1.75rem; letter-spacing: 1px;">ADMIN DASHBOARD</h1>
            <p class="text-muted mt-1 fs-7">Insure Trust management console</p>
        </div>
        <div class="d-none d-md-flex align-items-center gap-3">
            <a asp-controller="Policy" asp-action="CreatePolicy" class="btn btn-warning fw-bold text-dark rounded-0 px-4 py-2 border-dark border-3 shadow-sm" style="background: #fbbf24; border: 3px solid #000 !important;">
                + CREATE NEW POLICY TYPE
            </a>
        </div>
    </div>

    @if (TempData["AdminError"] != null)
    {
        <div class="alert bg-warning text-dark border-dark border-3 rounded-0 fw-bold p-3 mb-4 d-flex align-items-center" style="border: 3px solid #000 !important; box-shadow: 4px 4px 0px #000;">
            <i class="fa-solid fa-triangle-exclamation fs-4 me-3"></i>
            <div>@TempData["AdminError"]</div>
        </div>
    }

    <!-- Top KPIs - Neo-Brutalism Style -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="bg-white border-dark border-3 p-3 shadow-sm h-100" style="border: 3px solid #000 !important; border-bottom-width: 8px !important; border-right-width: 8px !important; background: #dbeafe !important;">
                <p class="text-uppercase tracking-wider text-muted mb-1 fw-bold fs-8">Total Customers</p>
                <h2 class="fw-black text-dark mb-0" style="font-size: 2.5rem;">@totalCustomers</h2>
                <div class="mt-1 text-muted fs-8">registered users</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="bg-white border-dark border-3 p-3 shadow-sm h-100" style="border: 3px solid #000 !important; border-bottom-width: 8px !important; border-right-width: 8px !important; background: #fef9c3 !important;">
                <p class="text-uppercase tracking-wider text-muted mb-1 fw-bold fs-8">Total Policies</p>
                <h2 class="fw-black text-dark mb-0" style="font-size: 2.5rem;">@totalPolicies</h2>
                <div class="mt-1 text-muted fs-8">all statuses</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="bg-white border-dark border-3 p-3 shadow-sm h-100" style="border: 3px solid #000 !important; border-bottom-width: 8px !important; border-right-width: 8px !important; background: #dcfce7 !important;">
                <p class="text-uppercase tracking-wider text-muted mb-1 fw-bold fs-8">Pending Approvals</p>
                <h2 class="fw-black text-dark mb-0" style="font-size: 2.5rem;">@pendingApprovals</h2>
                <div class="mt-1 text-muted fs-8">awaiting action</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="bg-white border-dark border-3 p-3 shadow-sm h-100" style="border: 3px solid #000 !important; border-bottom-width: 8px !important; border-right-width: 8px !important; background: #fee2e2 !important;">
                <p class="text-uppercase tracking-wider text-muted mb-1 fw-bold fs-8">Open Tickets</p>
                <h2 class="fw-black text-dark mb-0" style="font-size: 2.5rem;">@openTickets</h2>
                <div class="mt-1 text-muted fs-8">support queries</div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <!-- Pending Policy Approvals -->
        <div class="col-lg-7">
            <div class="bg-white border-dark border-3 p-4 shadow-sm h-100" style="border: 3px solid #000 !important; border-bottom-width: 6px !important; border-right-width: 6px !important;">
                <h5 class="fw-bold text-dark text-uppercase mb-4 border-bottom border-dark border-2 pb-2">Pending Policy Approvals</h5>
                
                <div class="d-flex flex-column gap-3">
                    @if (Model.PendingPolicies.Any())
                    {
                        @foreach (var p in Model.PendingPolicies)
                        {
                            <div class="p-3 border-dark border-2 d-flex justify-content-between align-items-center" style="border: 2px solid #000;">
                                <div>
                                    <h6 class="fw-bold mb-1">@p.PolicyNumber - @p.UserName</h6>
                                    <p class="text-muted mb-0 fs-8">@p.PolicyType — @p.PurchaseDate.ToString("dd MMM")</p>
                                </div>
                                <div class="d-flex gap-2">
                                    <form asp-action="UpdatePolicyStatus" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@p.Id" />
                                        <input type="hidden" name="action" value="Active" />
                                        <button type="submit" class="btn btn-sm btn-success rounded-0 border-dark border-2 fw-bold">Accept</button>
                                    </form>
                                    <form asp-action="UpdatePolicyStatus" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@p.Id" />
                                        <input type="hidden" name="action" value="Rejected" />
                                        <button type="submit" class="btn btn-sm btn-danger rounded-0 border-dark border-2 fw-bold">Reject</button>
                                    </form>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fa-solid fa-check text-success fs-3 mb-2"></i>
                            <p class="fw-bold text-muted mb-0">No pending approvals</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Support Tickets -->
        <div class="col-lg-5">
            <div class="bg-white border-dark border-3 p-4 shadow-sm h-100" style="border: 3px solid #000 !important; border-bottom-width: 6px !important; border-right-width: 6px !important;">
                <div class="d-flex justify-content-between align-items-center mb-4 border-bottom border-dark border-2 pb-2">
                    <h5 class="fw-bold text-dark text-uppercase mb-0">Support Tickets</h5>
                    <span class="badge bg-warning text-dark border-dark border-2 px-2 py-1 fs-9 fw-bold" style="border: 1px solid #000;">@openTickets OPEN</span>
                </div>

                <div class="d-flex flex-column gap-3">
                    @if (Model.SupportTickets.Any())
                    {
                        @foreach (var t in Model.SupportTickets)
                        {
                            <div class="p-3 border-dark border-2" style="border: 2px solid #000;">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <h6 class="fw-bold mb-0">@t.TicketNumber - @t.Subject</h6>
                                        <small class="text-muted">Aaroh • @t.CreatedAt.ToString("dd MMM")</small>
                                    </div>
                                    <form asp-action="UpdateSupportStatus" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@t.Id" />
                                        <select name="status" onchange="this.form.submit()" class="form-select form-select-sm rounded-0 border-dark border-2 fw-bold" style="width: auto;">
                                            <option value="Pending" selected="@(t.Status == "Pending")">Pending</option>
                                            <option value="InProgress" selected="@(t.Status == "InProgress")">In Progress</option>
                                            <option value="Resolved" selected="@(t.Status == "Resolved")">Resolved</option>
                                        </select>
                                    </form>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fa-solid fa-headset text-muted fs-3 mb-2"></i>
                            <p class="fw-bold text-muted mb-0">No active tickets</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Claim Management Section -->
    <div class="row g-4 mb-4">
        <div class="col-12">
            <div class="bg-white border-dark border-3 p-4 shadow-sm" style="border: 3px solid #000 !important; border-bottom-width: 8px !important; border-right-width: 8px !important;">
                <div class="d-flex justify-content-between align-items-center mb-4 border-bottom border-dark border-4 pb-2">
                    <h5 class="fw-black text-dark text-uppercase mb-0" style="letter-spacing: 1px;">
                        <i class="fa-solid fa-file-invoice-dollar me-2"></i> PENDING CLAIMS QUEUE
                    </h5>
                    <span class="badge bg-dark text-primary border-0 px-3 py-2 fw-900 fs-8">@Model.PendingClaims.Count AWAITING ADJUDICATION</span>
                </div>
                
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" style="border: 2px solid #000;">
                        <thead style="background: #000; color: #fff;">
                            <tr class="text-uppercase fs-8">
                                <th class="ps-3 py-3 fw-900">REF #</th>
                                <th class="py-3 fw-900">POLICY TYPE</th>
                                <th class="py-3 fw-900">DESCRIPTION</th>
                                <th class="py-3 text-end fw-900">AMOUNT</th>
                                <th class="pe-3 py-3 text-center fw-900">ACTION</th>
                            </tr>
                        </thead>
                        <tbody style="background: #fff;">
                            @if (Model.PendingClaims.Any())
                            {
                                @foreach (var claim in Model.PendingClaims)
                                {
                                    <tr style="border-bottom: 1px solid #000;">
                                        <td class="ps-3 py-3 fw-900">#@claim.ClaimNumber</td>
                                        <td class="py-3 fw-800 text-primary">@claim.PolicyTypeName</td>
                                        <td class="py-3 fs-8 fw-bold text-muted" style="max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@claim.Description</td>
                                        <td class="py-3 text-end fw-900 text-dark">₹@claim.MaturityAmount.ToString("N0")</td>
                                        <td class="pe-3 py-3 text-center">
                                            <a href="/Admin/Claims" class="btn-inst" style="background: #000; color: var(--primary); border: 2px solid #000; padding: 0.4rem 1.2rem; font-size: 0.7rem; font-weight: 900; box-shadow: 3px 3px 0px var(--primary);">PROCESS</a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-5 text-muted fw-bold">
                                        <i class="fa-solid fa-check-double fa-2x mb-2 d-block"></i>
                                        ALL CLAIMS HAVE BEEN PROCESSED.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="mt-4 text-end">
                    <a href="/Admin/Claims" class="fw-black text-dark text-decoration-none fs-8 text-uppercase">View All Claims History <i class="fa-solid fa-arrow-right ms-1"></i></a>
                </div>
            </div>
        </div>
    </div>

    <!-- Insurance Policy Types Section -->
    <div class="row g-4 mb-4">
        <div class="col-12">
            <div class="bg-white border-dark border-3 p-4 shadow-sm" style="border: 3px solid #000 !important; border-bottom-width: 6px !important; border-right-width: 6px !important;">
                <div class="d-flex justify-content-between align-items-center mb-4 border-bottom border-dark border-2 pb-2">
                    <h5 class="fw-bold text-dark text-uppercase mb-0">Insurance Policy Types</h5>
                    <a asp-controller="Policy" asp-action="CreatePolicy" class="btn btn-warning btn-sm fw-bold text-dark rounded-0 px-3 border-dark border-2" style="background: #fbbf24; border: 2px solid #000 !important;">
                        + ADD NEW POLICY TYPE
                    </a>
                </div>

                <div class="row g-3">
                    @if (Model.PolicyTypes.Any())
                    {
                        @foreach (var pt in Model.PolicyTypes)
                        {
                            <div class="col-md-4">
                                <div class="p-3 border-dark border-2 bg-white h-100" style="border: 2px solid #000; box-shadow: 4px 4px 0 #000;">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div class="fs-4">@pt.Icon</div>
                                        <a asp-controller="Policy" asp-action="update" asp-route-id="@pt.Id" class="btn btn-xs btn-outline-dark rounded-0 fw-bold border-2">EDIT</a>
                                    </div>
                                    <h6 class="fw-bold mb-0">@pt.Name</h6>
                                    <small class="text-muted d-block mb-2">@pt.Category</small>
                                    <p class="fs-8 text-muted mb-3" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">@pt.Description</p>
                                    <div class="d-flex justify-content-between align-items-center mt-auto border-top border-dark border-opacity-10 pt-2">
                                        <span class="fw-bold text-primary fs-8">₹@pt.BaseMonthlyPremium.ToString("N0")/mo base</span>
                                        <span class="fs-9 text-muted">Added: @pt.AddedAt.ToString("dd MMM yyyy")</span>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="col-12 text-center py-5">
                            <p class="text-muted fw-bold">No policy types defined yet.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Registered Customers Section -->
    <div class="row g-4 mb-4">
        <div class="col-12">
            <div class="bg-white border-dark border-3 p-4 shadow-sm" style="border: 3px solid #000 !important; border-bottom-width: 6px !important; border-right-width: 6px !important;">
                <div class="d-flex justify-content-between align-items-center mb-4 border-bottom border-dark border-2 pb-2">
                    <h5 class="fw-bold text-dark text-uppercase mb-0">Registered Customers</h5>
                    <span class="text-muted fs-8 fw-bold">@Model.Users.Count customers</span>
                </div>

                <div class="table-responsive">
                    <table class="table table-bordered border-dark align-middle mb-0" style="border: 1px solid #000;">
                        <thead style="background: #000 !important; color: #fbbf24 !important;">
                            <tr>
                                <th class="fw-bold fs-8" style="color: #fbbf24 !important;">USER #</th>
                                <th class="fw-bold fs-8" style="color: #fbbf24 !important;">NAME</th>
                                <th class="fw-bold fs-8" style="color: #fbbf24 !important;">EMAIL</th>
                                <th class="fw-bold fs-8" style="color: #fbbf24 !important;">ROLE</th>
                                <th class="fw-bold fs-8" style="color: #fbbf24 !important;">KYC</th>
                                <th class="fw-bold fs-8 text-center" style="color: #fbbf24 !important;">JOINED</th>
                                <th class="fw-bold fs-8 text-end" style="color: #fbbf24 !important;">BALANCE</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Users.Any())
                            {
                                @foreach (var user in Model.Users)
                                {
                                    <tr class="bg-white">
                                        <td class="fw-bold fs-8">@user.UserNumber</td>
                                        <td class="fs-8">@user.Name</td>
                                        <td class="fs-8">@user.Email</td>
                                        <td>
                                            <span class="badge rounded-0 border-dark border-1 px-2 py-1 fs-9 fw-bold" style="border: 1px solid #000; background: @(user.Role == "Admin" ? "#a855f7" : "#e5e7eb"); color: @(user.Role == "Admin" ? "white" : "black")">@user.Role.ToUpper()</span>
                                        </td>
                                        <td>
                                            @if (user.KycStatus?.ToLower() == "verified")
                                            {
                                                <span class="badge rounded-0 border-dark border-1 px-2 py-1 fs-9 fw-bold bg-success text-white" style="border: 1px solid #000;">VERIFIED</span>
                                            }
                                            else
                                            {
                                                <span class="badge rounded-0 border-dark border-1 px-2 py-1 fs-9 fw-bold bg-warning text-dark" style="border: 1px solid #000;">PENDING</span>
                                            }
                                        </td>
                                        <td class="fs-8 text-center">@user.CreatedAt.ToString("dd MMM yyyy")</td>
                                        <td class="fw-bold fs-8 text-end">₹@user.Balance.ToString("N0")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-4 text-muted fw-bold">No registered users found.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <style>
        .fade-in-up {
            opacity: 0;
            transform: translateY(20px);
            animation: fadeInUp 0.8s ease-out forwards;
        }
        @@keyframes fadeInUp {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        .tracking-wider { letter-spacing: 1px; }
        .btn-xs { padding: 0.1rem 0.5rem; font-size: 0.65rem; }
    </style>
}
