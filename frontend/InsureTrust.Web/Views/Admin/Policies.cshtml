@{
    ViewData["Title"] = "Policy Infrastructure";
}

<section class="admin-policy-hub">

    <div class="admin-policy-hub-head">
        <div class="admin-policy-hub-intro">
            <p class="admin-policy-hub-label">CONTROL CENTER OVERVIEW</p>
            <h1>Policy Infrastructure</h1>
            <p class="admin-policy-hub-desc">
                Command your institutional insurance ecosystem. Manage regulatory compliance,
                financial parameters, and operational flows from a centralized ledger interface.
            </p>
        </div>
        <div>
            <a href="javascript:void(0);" class="admin-policy-hub-new-btn">+ NEW POLICY</a>
        </div>
    </div>

    <!-- <div class="admin-ledger-divider"></div> -->

    <!-- Core Management -->
    <h4 class="admin-policy-hub-section">Core Management</h4>
    <div class="admin-ledger-divider" style="margin-bottom: 1.75rem;"></div>

    <div class="admin-policy-hub-grid">

        <a href="javascript:void(0);" class="admin-policy-hub-card">
            <div class="admin-policy-hub-card-icon">
                <i class="fas fa-layer-group"></i>
            </div>
            <h3>Manage Policy Types</h3>
            <p>Edit, add, or remove categories (Life, Health, Vehicle) to define your product portfolio.</p>
        </a>

        <a href="javascript:void(0);" class="admin-policy-hub-card">
            <div class="admin-policy-hub-card-icon">
                <i class="fas fa-database"></i>
            </div>
            <h3>All Sold Policies</h3>
            <p>View a master database of every policy purchased by customers across all jurisdictions.</p>
        </a>

        <a href="javascript:void(0);" class="admin-policy-hub-card admin-policy-hub-card-live">
            <span class="admin-policy-hub-dot"></span>
            <div class="admin-policy-hub-card-icon">
                <i class="fas fa-clipboard-check"></i>
            </div>
            <h3>Pending Approvals</h3>
            <p>Review and sign off on new policy applications awaiting institutional verification.</p>
        </a>

    </div>

</section>
