@{
    ViewData["Title"] = "Policy Infrastructure";
}

<section class="admin-policy-hub fade-in-up">

    <div class="page-heading d-flex justify-content-between align-items-end mb-5">
        <div class="admin-policy-hub-intro">
            <span class="meta-line text-primary fw-bold text-uppercase tracking-wider fs-8"><i class="fa-solid fa-user-shield me-1"></i> Control Center Overview</span>
            <h1 class="display-5 fw-bold text-white mb-2 mt-2">Policy Infrastructure</h1>
            <p class="text-muted fs-5 mb-0">
                Command your institutional insurance ecosystem. Manage regulatory compliance,
                financial parameters, and operational flows from a centralized ledger interface.
            </p>
        </div>
        <div class="d-none d-md-block">
            <a asp-controller="Policy" asp-action="CreatePolicy" class="btn btn-warning fw-bold text-dark rounded-0 px-4 py-2 border-dark border-3 shadow-sm" style="background: #fbbf24; border: 3px solid #000 !important;">
                <i class="fa-solid fa-plus me-2"></i> NEW POLICY TYPE
            </a>
        </div>
    </div>

    <div class="row g-4">
        <!-- Manage Policy Types -->
        <div class="col-md-4">
            <div class="brut-card h-100">
                <div class="brut-card-body">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="btn-brut-icon fs-4">
                            <i class="fas fa-layer-group"></i>
                        </div>
                        <span class="brut-badge">Schema</span>
                    </div>
                    <h3 class="brut-title">Manage Types</h3>
                    <p class="brut-text">Edit, add, or remove categories (Life, Health, Vehicle) to define your product portfolio.</p>
                </div>
                <div class="brut-footer">
                    <a asp-controller="Policy" asp-action="ManageTypes" class="text-white text-decoration-none fw-bold fs-7 w-100 text-uppercase d-flex align-items-center justify-content-between">
                        Launch Designer <i class="fa-solid fa-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- All Sold Policies -->
        <div class="col-md-4">
            <div class="brut-card h-100">
                <div class="brut-card-body">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="btn-brut-icon fs-4">
                            <i class="fas fa-database"></i>
                        </div>
                        <span class="brut-badge">Registry</span>
                    </div>
                    <h3 class="brut-title">Registry Database</h3>
                    <p class="brut-text">View a master database of every policy purchased by customers across all jurisdictions.</p>
                </div>
                <div class="brut-footer">
                    <a asp-controller="Policy" asp-action="GetAllPolicy" class="text-white text-decoration-none fw-bold fs-7 w-100 text-uppercase d-flex align-items-center justify-content-between">
                        View Records <i class="fa-solid fa-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Pending Approvals -->
        <div class="col-md-4">
            <div class="brut-card h-100 position-relative">
                <div class="position-absolute top-0 end-0 p-3">
                    <span class="admin-policy-hub-dot"></span>
                </div>
                <div class="brut-card-body">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="btn-brut-icon fs-4">
                            <i class="fas fa-clipboard-check"></i>
                        </div>
                        <span class="brut-badge">Live Queue</span>
                    </div>
                    <h3 class="brut-title">Pending Queue</h3>
                    <p class="brut-text">Review and sign off on new policy applications awaiting institutional verification.</p>
                </div>
                <div class="brut-footer">
                    <a asp-controller="Policy" asp-action="GetAllPending" class="text-white text-decoration-none fw-bold fs-7 w-100 text-uppercase d-flex align-items-center justify-content-between">
                        Process Queue <i class="fa-solid fa-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

</section>

@section Scripts {
    <style>
        .admin-policy-hub-dot {
            display: inline-block;
            width: 10px;
            height: 10px;
            background-color: var(--warning);
            border-radius: 50%;
            box-shadow: 0 0 10px var(--warning);
            animation: pulse 2s infinite;
        }
        @@keyframes pulse {
            0% { transform: scale(1); opacity: 1; }
            50% { transform: scale(1.5); opacity: 0.5; }
            100% { transform: scale(1); opacity: 1; }
        }
        .fs-8 { font-size: 0.75rem; }
    </style>
}
