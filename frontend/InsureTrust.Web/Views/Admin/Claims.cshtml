@model List<InsureTrust.Web.Models.AdminClaimViewModel>

@{
    ViewData["Title"] = "Claims Management";
    var pendingCount = Model.Count(c => 
        string.Equals(c.ClaimStatus, "Pending", StringComparison.OrdinalIgnoreCase) || 
        string.Equals(c.Status, "Pending", StringComparison.OrdinalIgnoreCase));
    var approvedCount = Model.Count(c => 
        string.Equals(c.ClaimStatus, "Approved", StringComparison.OrdinalIgnoreCase) || 
        string.Equals(c.Status, "Approved", StringComparison.OrdinalIgnoreCase));
    var deniedCount = Model.Count(c => 
        string.Equals(c.ClaimStatus, "Denied", StringComparison.OrdinalIgnoreCase) || 
        string.Equals(c.Status, "Denied", StringComparison.OrdinalIgnoreCase));
    var totalMaturityAmount = Model.Sum(c => c.MaturityAmount);
}

<section class="admin-claims-page fade-in-up">
    <div class="page-heading d-flex justify-content-between align-items-end mb-5" style="border-bottom: 4px solid #000; padding-bottom: 2rem;">
        <div>
            <span class="brut-badge" style="background: #000; color: var(--primary); padding: 0.5rem 1rem; font-weight: 900; margin-bottom: 1rem; display: inline-block;">ADMINISTRATION / CLAIMS</span>
            <h1 class="display-4 fw-black text-dark mb-0 mt-2" style="letter-spacing: -2px;">CLAIMS MANAGEMENT</h1>
            <p class="text-muted mt-2 fs-5 fw-bold text-uppercase">VERIFY AND PROCESS INCOMING INSURANCE CLAIMS.</p>
        </div>
        <div class="d-none d-md-flex align-items-center gap-3">
            <a href="/Admin/Dashboard" class="btn-inst" style="background: #000; color: #fff; border: 4px solid #000; box-shadow: 6px 6px 0px var(--primary); padding: 1rem 2rem; font-weight: 900;">
                <i class="fa-solid fa-arrow-left me-2"></i>DASHBOARD
            </a>
        </div>
    </div>

    @if (TempData["ClaimActionSuccess"] is string successMessage)
    {
        <div class="alert bg-success text-white mb-4" style="border: 4px solid #000; box-shadow: 6px 6px 0px #000; font-weight: 800;">
            <i class="fa-solid fa-check-circle me-2"></i> @successMessage
        </div>
    }

    @if (TempData["ClaimActionError"] is string errorMessage)
    {
        <div class="alert bg-danger text-white mb-4" style="border: 4px solid #000; box-shadow: 6px 6px 0px #000; font-weight: 800;">
            <i class="fa-solid fa-triangle-exclamation me-2"></i> @errorMessage
        </div>
    }

    <div class="row mb-5 g-4">
        <div class="col-md-3">
            <div class="panel-card p-4" style="border: 4px solid #000; box-shadow: 6px 6px 0px var(--primary); background: #fff;">
                <p class="text-uppercase fw-900 fs-7 mb-1">Pending Review</p>
                <h2 class="display-5 fw-black mb-0">@pendingCount.ToString("N0")</h2>
            </div>
        </div>
        <div class="col-md-3">
            <div class="panel-card p-4" style="border: 4px solid #000; box-shadow: 6px 6px 0px var(--success); background: #fff;">
                <p class="text-uppercase fw-900 fs-7 mb-1">Total Approved</p>
                <h2 class="display-5 fw-black mb-0">@approvedCount.ToString("N0")</h2>
            </div>
        </div>
        <div class="col-md-3">
            <div class="panel-card p-4" style="border: 4px solid #000; box-shadow: 6px 6px 0px var(--danger); background: #fff;">
                <p class="text-uppercase fw-900 fs-7 mb-1">Total Denied</p>
                <h2 class="display-5 fw-black mb-0">@deniedCount.ToString("N0")</h2>
            </div>
        </div>
        <div class="col-md-3">
            <div class="panel-card p-4" style="border: 4px solid #000; box-shadow: 6px 6px 0px #000; background: var(--primary);">
                <p class="text-uppercase fw-900 fs-7 mb-1">Maturity Liability</p>
                <h2 class="display-5 fw-black mb-0">₹@totalMaturityAmount.ToString("N0")</h2>
            </div>
        </div>
    </div>

    <div class="panel-card h-100 p-0 overflow-hidden mb-4" style="border: 4px solid #000; box-shadow: 8px 8px 0px #000; background: #fff;">
        <div class="p-4 border-bottom border-4 border-dark d-flex justify-content-between align-items-center" style="background: #000; color: #fff;">
            <h4 class="mb-0 fw-900 text-uppercase"><i class="fa-solid fa-list-check me-2 text-primary"></i> Claims Processing Queue</h4>
            <div class="input-group" style="width: 300px; border: 3px solid var(--primary);">
                <span class="input-group-text bg-white border-0 text-dark">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </span>
                <input type="text" id="adminClaimsFilter" class="form-control border-0 shadow-none fw-bold" placeholder="FILTER CLAIMS..." style="font-size: 0.8rem;">
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle" id="adminClaimsTable">
                <thead class="text-uppercase fs-7 text-dark" style="background: #f0f0f0; border-bottom: 2px solid #000;">
                    <tr>
                        <th class="ps-4 py-3 fw-900">Claim Ref</th>
                        <th class="py-3 fw-900">Policy</th>
                        <th class="py-3 fw-900">Type</th>
                        <th class="py-3 fw-900" style="min-width: 250px;">Description</th>
                        <th class="py-3 text-end fw-900">Amount</th>
                        <th class="py-3 text-center fw-900">Status</th>
                        <th class="py-3 fw-900">Submitted</th>
                        <th class="pe-4 py-3 text-center fw-900" style="min-width: 400px;">Adjudication</th>
                    </tr>
                </thead>
                <tbody style="background: #fff;">
                    @if (Model.Any())
                    {
                        @foreach (var claim in Model)
                        {
                            var status = !string.IsNullOrWhiteSpace(claim.ClaimStatus) ? claim.ClaimStatus : claim.Status;
                            if (string.IsNullOrWhiteSpace(status)) status = "Pending";
                            var statusLower = status.ToLower();
                            string badgeStyle = "background: var(--primary); border: 2px solid #000; color: #000;";
                            
                            if (statusLower == "approved" || statusLower == "paid") badgeStyle = "background: var(--success); border: 2px solid #000; color: #fff;";
                            else if (statusLower == "denied" || statusLower == "rejected") badgeStyle = "background: var(--danger); border: 2px solid #000; color: #fff;";

                            <tr style="border-bottom: 1px solid #ddd;">
                                <td class="ps-4 py-3 fw-900 text-dark">#@claim.ClaimNumber</td>
                                <td class="py-3 fw-800 text-primary">@claim.PolicyNumber</td>
                                <td class="py-3 fw-bold text-muted" style="font-size: 0.75rem;">@claim.PolicyTypeName</td>
                                <td class="py-3 fw-bold" style="font-size: 0.85rem; color: #333;">@claim.Description</td>
                                <td class="py-3 text-end fw-900 text-dark">₹@claim.MaturityAmount.ToString("N0")</td>
                                <td class="py-3 text-center">
                                    <span class="badge px-3 py-2 fw-900" style="@badgeStyle">
                                        @status.ToUpper()
                                    </span>
                                </td>
                                <td class="py-3 fw-bold text-muted" style="font-size: 0.8rem;">@claim.SubmittedAt.ToString("dd MMM yyyy")</td>
                                <td class="pe-4 py-3">
                                    @if (statusLower == "pending")
                                    {
                                        <form asp-controller="Admin" asp-action="UpdateClaimStatus" method="post" class="admin-claims-action-form d-flex gap-2">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@claim.Id" />
                                            <input type="text" name="remarks" class="form-control fw-bold admin-claims-remarks" placeholder="ADD ADJUDICATION REMARKS..." style="border: 2px solid #000; font-size: 0.75rem; flex-grow: 1;" value="@claim.AdminRemarks" />
                                            <button type="submit" name="action" value="Approve" class="btn-inst" style="background: var(--success); color: #fff; border: 2px solid #000; padding: 0.4rem 0.8rem; font-size: 0.7rem; box-shadow: 2px 2px 0px #000;">APPROVE</button>
                                            <button type="submit" name="action" value="Deny" class="btn-inst" style="background: var(--danger); color: #fff; border: 2px solid #000; padding: 0.4rem 0.8rem; font-size: 0.7rem; box-shadow: 2px 2px 0px #000;">DENY</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <div class="p-2 border-start border-4 border-dark bg-light fw-bold" style="font-size: 0.75rem;">
                                            <span class="text-muted d-block text-uppercase mb-1">Process Remarks:</span>
                                            @(string.IsNullOrWhiteSpace(claim.AdminRemarks) ? "NO REMARKS PROVIDED" : claim.AdminRemarks)
                                            <div class="mt-1 text-muted" style="font-size: 0.65rem;">PROCESSED ON: @(claim.ProcessedAt.HasValue ? claim.ProcessedAt.Value.ToString("dd MMM yyyy") : "N/A")</div>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-folder-open fa-3x mb-3" style="color: #000; opacity: 0.1;"></i>
                                <h5 class="text-dark fw-900">NO CLAIMS TO PROCESS</h5>
                                <p class="mb-0 fw-bold">THE CLAIMS QUEUE IS CURRENTLY EMPTY.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        (function () {
            const filterInput = document.getElementById("adminClaimsFilter");
            const table = document.getElementById("adminClaimsTable");

            if (filterInput && table) {
                filterInput.addEventListener("input", function () {
                    const term = filterInput.value.toLowerCase().trim();
                    const rows = table.querySelectorAll("tbody tr");
                    rows.forEach(row => {
                        const text = row.textContent.toLowerCase();
                        row.style.display = text.includes(term) ? "" : "none";
                    });
                });
            }

            const forms = document.querySelectorAll(".admin-claims-action-form");
            forms.forEach(form => {
                form.addEventListener("submit", function (e) {
                    const action = e.submitter.value;
                    const remarks = form.querySelector(".admin-claims-remarks").value.trim();

                    if (action === "Deny" && !remarks) {
                        e.preventDefault();
                        alert("MANDATORY FIELD: A justification remark is required for claim denial.");
                        form.querySelector(".admin-claims-remarks").focus();
                        return;
                    }

                    if (!confirm(`CONFIRMATION REQUIRED: Proceed with ${action.toUpperCase()} action for this claim?`)) {
                        e.preventDefault();
                    }
                });
            });
        })();
    </script>
}
