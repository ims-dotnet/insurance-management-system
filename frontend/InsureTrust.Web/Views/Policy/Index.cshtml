@model IEnumerable<InsureTrust.Web.Models.PolicyTypeDto>

@{
    ViewData["Title"] = "Bureau Registry · Classifications";
}

<style>
    /* ── REGISTRY INDEX — Bureau of Risk ── */
    .registry-header { margin-bottom: 40px; }
    .registry-eyebrow {
        font-size: 10px; font-weight: 700; letter-spacing: 2.5px;
        text-transform: uppercase; color: var(--text3); margin-bottom: 8px;
    }
    .registry-heading {
        font-family: var(--font-h); font-size: 36px; font-weight: 900;
        color: var(--text); line-height: 1.1; margin-bottom: 12px;
    }
    .registry-sub { font-size: 13px; color: var(--text2); max-width: 600px; line-height: 1.6; }

    /* ── REGISTRY GRID ── */
    .registry-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 32px;
        margin-top: 48px;
    }

    .registry-item {
        background: #fff;
        border: 1px solid var(--border);
        display: flex;
        flex-direction: column;
        transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
        position: relative;
    }

    .registry-item:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 30px rgba(0,0,0,0.08);
        border-color: var(--border-dark);
    }

    .registry-item-top {
        padding: 32px 32px 24px;
        flex-grow: 1;
    }

    .registry-item-icon {
        width: 56px;
        height: 56px;
        background: var(--bg2);
        border: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
        margin-bottom: 24px;
    }

    .registry-item-category {
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: var(--accent);
        margin-bottom: 8px;
    }

    .registry-item-name {
        font-family: var(--font-h);
        font-size: 24px;
        font-weight: 900;
        color: var(--text);
        margin-bottom: 12px;
        line-height: 1.2;
    }

    .registry-item-desc {
        font-family: var(--font-doc);
        font-size: 14px;
        color: var(--text2);
        line-height: 1.6;
        margin-bottom: 24px;
    }

    .registry-item-meta {
        padding: 16px 32px;
        background: var(--bg);
        border-top: 1px solid var(--border);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .registry-price {
        font-size: 12px;
        font-weight: 700;
        color: var(--text);
    }

    .registry-price span {
        font-size: 10px;
        font-weight: 400;
        color: var(--text3);
        margin-left: 4px;
    }

    .registry-action-btn {
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: var(--text);
        text-decoration: none;
        border-bottom: 2px solid var(--text);
        padding-bottom: 2px;
        transition: all 0.2s;
    }

    .registry-action-btn:hover {
        color: var(--accent);
        border-bottom-color: var(--accent);
    }

    .registry-admin-tools {
        position: absolute;
        top: 12px;
        right: 12px;
        display: flex;
        gap: 8px;
        opacity: 0;
        transition: opacity 0.2s;
    }

    .registry-item:hover .registry-admin-tools {
        opacity: 1;
    }

    .tool-btn {
        width: 28px;
        height: 28px;
        background: #fff;
        border: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        color: var(--text2);
        text-decoration: none;
        transition: all 0.2s;
    }

    .tool-btn:hover {
        background: var(--bg2);
        color: var(--text);
    }

    .tool-btn-danger:hover {
        background: var(--accent);
        color: #fff;
        border-color: var(--accent);
    }

    .empty-registry {
        text-align: center;
        padding: 100px 0;
        border: 1px dashed var(--border-dark);
        margin-top: 48px;
    }

    .empty-icon { font-size: 48px; margin-bottom: 16px; opacity: 0.5; }
    .empty-msg { font-family: var(--font-h); font-size: 24px; color: var(--text2); }

    .new-classification-btn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: var(--text);
        color: var(--bg);
        padding: 12px 24px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        text-decoration: none;
        margin-top: 24px;
        transition: background 0.2s;
    }

    .new-classification-btn:hover {
        background: var(--accent);
        color: #fff;
    }
</style>

<div class="registry-header">
    <div class="registry-eyebrow">Division IV · Personnel Risk Management</div>
    <h1 class="registry-heading">Insurance Classifications</h1>
    <p class="registry-sub">Official directory of approved insurance products and coverage parameters. Select a classification to begin filing a new policy record.</p>
    
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="CreatePolicy" class="new-classification-btn">
            <span>+ New Classification</span>
        </a>
    }
</div>

@if (!Model.Any())
{
    <div class="empty-registry">
        <div class="empty-icon">📋</div>
        <div class="empty-msg">Registry Archive Empty</div>
        <p style="color:var(--text3); margin-top:8px;">No active classifications found in the master index.</p>
    </div>
}
else
{
    <div class="registry-grid">
        @foreach (var item in Model)
        {
            <div class="registry-item">
                @if (User.IsInRole("Admin"))
                {
                    <div class="registry-admin-tools">
                        <a asp-action="update" asp-route-id="@item.Id" class="tool-btn" title="Edit Classification">✎</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="tool-btn tool-btn-danger" title="Revoke Classification">✕</a>
                    </div>
                }

                <div class="registry-item-top">
                    <div class="registry-item-icon">
                        @(string.IsNullOrEmpty(item.Icon) ? "📜" : item.Icon)
                    </div>
                    <div class="registry-item-category">@item.Category Division</div>
                    <h2 class="registry-item-name">@item.Name</h2>
                    <p class="registry-item-desc">@item.Description</p>
                </div>

                <div class="registry-item-meta">
                    <div class="registry-price">
                        From ₹3,000<span>/month</span>
                    </div>
                    <a asp-action="Purchase" asp-route-id="@item.Id" class="registry-action-btn">Buy Policy →</a>
                </div>
            </div>
        }
    </div>
}