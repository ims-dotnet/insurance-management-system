@model IEnumerable<InsureTrust.Web.Models.PolicyTypeDto>

@{
    ViewData["Title"] = "Policy Desk";
}

<section class="fade-in-up">
<div class="brut-page-header mb-5">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <span class="text-primary fw-900 text-uppercase" style="font-size: 0.65rem; letter-spacing: 2px;">Coverage Desk</span>
            <h1 class="display-6 fw-900 text-white mb-0 mt-1" style="text-transform: uppercase; letter-spacing: -1px;">Insurance Policies</h1>
            <p class="text-white-50 mt-1 mb-0" style="font-size: 0.8rem;">Select a coverage plan that fits your needs.</p>
        </div>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="CreatePolicy" class="btn-inst btn-inst-primary py-2 px-3">
                <i class="fa-solid fa-plus me-2"></i>NEW POLICY
            </a>
        }
    </div>
</div>

    @if (!Model.Any())
    {
        <div class="text-center p-5 border border-secondary border-opacity-25 rounded-4 bg-dark bg-opacity-25 mt-4">
            <i class="fa-solid fa-folder-open fa-4x text-muted mb-3 opacity-50"></i>
            <h3 class="text-white">No Policies Available</h3>
            <p class="text-muted">There are currently no active insurance policies in the system.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="brut-card h-100 position-relative">
                        
                        @if (User.IsInRole("Admin"))
                        {
                            <div class="position-absolute top-0 end-0 p-2 z-3 d-flex gap-1">
                                <a asp-action="update" asp-route-id="@item.Id" class="btn-brut-icon" title="Edit">
                                    <i class="fa-solid fa-pen"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn-brut-icon-danger" title="Delete">
                                    <i class="fa-solid fa-trash"></i>
                                </a>
                            </div>
                        }

                        <div class="brut-card-body">
                            <div class="mb-3 text-dark fs-2">
                                @if (string.IsNullOrEmpty(item.Icon))
                                {
                                    <i class="fa-solid fa-file-shield"></i>
                                }
                                else
                                {
                                    <span>@item.Icon</span>
                                }
                            </div>
                            
                            <div class="brut-badge">
                                @item.Category Division
                            </div>
                            
                            <h3 class="brut-title">@item.Name</h3>
                            <p class="brut-text">@item.Description</p>
                        </div>

                        <div class="brut-footer">
                            <div>
                                <div class="text-uppercase fw-900" style="font-size: 0.6rem; color: var(--primary);">Premium</div>
                                <div class="d-flex align-items-baseline">
                                    <span class="fw-900 fs-4 text-white">₹3,000</span>
                                    <span class="ms-1" style="font-size: 0.65rem; color: #888;">/mo</span>
                                </div>
                            </div>
                            <a asp-action="Purchase" asp-route-id="@item.Id" class="btn-inst btn-inst-primary py-2 px-3" style="font-size: 0.75rem;">
                                BUY POLICY <i class="fa-solid fa-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</section>