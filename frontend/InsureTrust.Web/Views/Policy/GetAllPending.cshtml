@using InsureTrust.Web.Models
@model IEnumerable<PolicyDto>

@{
    ViewData["Title"] = "Risk Assessment — Pending Queue";
}

<!-- PAGE HEADER -->
<div class="page-header-row">
    <div>
        <div class="page-eyebrow">Risk Assessment · Pending Underwriting</div>
        <h1 class="page-heading">Assessment Queue</h1>
        <p class="page-sub">Policies awaiting administrative review and approval. Ensure compliance checks before granting active status.</p>
    </div>
</div>

<hr class="bor-divider" />

@if (TempData["PolicyActionSuccess"] != null)
{
    <div class="alert alert-success border-0 bg-success bg-opacity-10 text-success mb-4 rounded-3 p-3">
        <i class="fa-solid fa-circle-check me-2"></i> @TempData["PolicyActionSuccess"]
    </div>
}
@if (TempData["PolicyActionError"] != null)
{
    <div class="alert alert-danger border-0 bg-danger bg-opacity-10 text-danger mb-4 rounded-3 p-3">
        <i class="fa-solid fa-circle-exclamation me-2"></i> @TempData["PolicyActionError"]
    </div>
}

@if (!Model.Any())
{
    <div class="empty-state">
        <div class="empty-icon">⏳</div>
        <div class="empty-msg">Queue Clear</div>
        <div class="empty-sub">There are currently no pending policies requiring assessment.</div>
    </div>
}
else
{
    <div class="bor-table-wrap">
        <table class="bor-table">
            <thead>
                <tr>
                    <th>Ref ID</th>
                    <th>Policy Number</th>
                    <th>Classification</th>
                    <th>Status</th>
                    <th>Requested Amount</th>
                    <th>Term</th>
                    <th>Filed Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>TYPE-@item.Id.ToString("D3")</td>
                        <td class="policy-number">@item.PolicyNumber</td>
                        <td>
                            <div class="coverage-type">@item.PolicyTypeName</div>
                            <div style="font-size:10px;color:var(--text3);">@item.Category</div>
                        </td>
                        <td>
                            <span class="bor-badge badge-pending">PENDING</span>
                        </td>
                        <td>₹@item.PackageAmount.ToString("N0")</td>
                        <td>@item.Tenure months</td>
                        <td class="period-range">@item.PurchaseDate.ToString("dd MMM yyyy")</td>
                        <td>
                            <div class="table-actions d-flex gap-2">
                                <form asp-controller="Admin" asp-action="UpdatePolicyStatus" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <input type="hidden" name="action" value="Active" />
                                    <button type="submit" class="bor-btn bor-btn-primary bor-btn-sm" onclick="return confirm('Approve this policy?')">Approve</button>
                                </form>
                                
                                <button type="button" class="bor-btn bor-btn-danger bor-btn-sm" 
                                        onclick="showRejectModal(@item.Id, '@item.PolicyNumber')">Reject</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<!-- Rejection Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-secondary shadow-lg">
            <div class="modal-header border-secondary">
                <h5 class="modal-title text-white">Reject Policy Application</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Admin" asp-action="UpdatePolicyStatus" method="post">
                <div class="modal-body">
                    <input type="hidden" id="rejectPolicyId" name="id" />
                    <input type="hidden" name="action" value="Reject" />
                    <p class="text-muted">You are about to reject policy <span id="rejectPolicyNumber" class="text-white fw-bold"></span>. Please provide a reason.</p>
                    <div class="mb-3">
                        <label class="form-label text-white">Rejection Remarks</label>
                        <textarea name="remarks" class="form-control bg-dark text-white border-secondary" rows="3" required placeholder="Reason for rejection..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-outline-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger rounded-pill px-4">Confirm Rejection</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showRejectModal(id, number) {
            document.getElementById('rejectPolicyId').value = id;
            document.getElementById('rejectPolicyNumber').textContent = number;
            var modal = new bootstrap.Modal(document.getElementById('rejectModal'));
            modal.show();
        }
    </script>
}