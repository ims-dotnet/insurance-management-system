@model InsureTrust.Productweb.DTOs.CreatePolicyDto

@{
    ViewData["Title"] = "Policy Application · Filing";
}

<style>
    /* ── PURCHASE / POLICY FILING ── */
    .pur-header-row {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;
        flex-wrap: wrap;
        margin-bottom: 36px;
    }

    .pur-eyebrow {
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 2.5px;
        text-transform: uppercase;
        color: var(--text3);
        margin-bottom: 8px;
    }

    .pur-heading {
        font-family: var(--font-h);
        font-size: 38px;
        font-weight: 900;
        color: var(--text);
        line-height: 1.05;
        margin-bottom: 10px;
        text-transform: uppercase;
    }

    .pur-sub {
        font-size: 12px;
        color: var(--text2);
        max-width: 520px;
        line-height: 1.7;
    }

    .pur-header-actions {
        display: flex;
        gap: 10px;
        align-items: center;
        padding-top: 12px;
        flex-shrink: 0;
    }

    /* ── FILING CARD ── */
    .pur-card {
        background: #fff;
        border: 1px solid var(--border);
        padding: 40px 48px;
        max-width: 800px;
        position: relative;
        z-index: 1;
        margin-bottom: 60px;
    }

    /* ── CARD META HEADER ── */
    .pur-card-meta {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        padding-bottom: 20px;
        margin-bottom: 32px;
        border-bottom: 1px solid var(--border);
    }

    .pur-card-ref {
        font-size: 9px;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: var(--text3);
        margin-bottom: 4px;
    }

    .pur-card-title {
        font-family: var(--font-h);
        font-size: 20px;
        font-weight: 700;
        color: var(--text);
    }

    .pur-stamp {
        border: 2px solid var(--border-dark);
        padding: 5px 14px;
        font-size: 8px;
        font-weight: 700;
        letter-spacing: 2.5px;
        text-transform: uppercase;
        color: var(--text3);
        white-space: nowrap;
    }

    /* ── SECTION ── */
    .pur-section {
        margin-bottom: 36px;
    }

    .pur-section-head {
        display: flex;
        align-items: center;
        gap: 12px;
        padding-bottom: 12px;
        border-bottom: 2px solid var(--text);
        margin-bottom: 28px;
    }

    .pur-section-num {
        width: 24px;
        height: 24px;
        background: var(--text);
        color: var(--bg);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 10px;
        font-weight: 700;
        flex-shrink: 0;
        font-family: var(--font-h);
    }

    .pur-section-label {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: var(--text);
    }

    /* ── PARAM GRID ── */
    .pur-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 32px 48px;
    }

    .pur-field {
        display: flex;
        flex-direction: column;
    }

    /* ── RANGE SLIDER ── */
    .pur-range-value {
        background: var(--text);
        color: var(--bg);
        padding: 5px 14px;
        font-size: 18px;
        font-weight: 700;
        font-family: var(--font-h);
        display: inline-block;
        margin-bottom: 14px;
        letter-spacing: 0.5px;
    }

    .pur-range-hint {
        font-size: 9px;
        color: var(--text3);
        letter-spacing: 1px;
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .bor-range {
        -webkit-appearance: none;
        appearance: none;
        width: 100%;
        height: 3px;
        background: var(--border-dark);
        outline: none;
        accent-color: var(--text);
        cursor: pointer;
        margin-top: 4px;
    }

    .bor-range::-webkit-slider-thumb {
        -webkit-appearance: none;
        appearance: none;
        width: 16px;
        height: 16px;
        background: var(--text);
        cursor: pointer;
        border-radius: 0;
    }

    .bor-range::-moz-range-thumb {
        width: 16px;
        height: 16px;
        background: var(--text);
        cursor: pointer;
        border-radius: 0;
        border: none;
    }

    .pur-range-labels {
        display: flex;
        justify-content: space-between;
        font-size: 9px;
        color: var(--text3);
        margin-top: 6px;
        letter-spacing: 0.5px;
    }

    /* ── SUMMARY BOX ── */
    .pur-summary-box {
        background: var(--bg);
        border: 1px solid var(--border);
        padding: 20px 24px;
        margin-top: 8px;
    }

    .pur-summary-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 8px 0;
        border-bottom: 1px solid var(--bg2);
        font-size: 12px;
    }

    .pur-summary-row:last-child {
        border-bottom: none;
        font-weight: 700;
        font-size: 14px;
        padding-top: 12px;
        margin-top: 4px;
    }

    .pur-summary-label {
        font-size: 9px;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: var(--text3);
    }

    .pur-summary-val {
        font-weight: 600;
        color: var(--text);
        font-family: var(--font-h);
    }

    /* ── ACTION ROW ── */
    .pur-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        padding-top: 28px;
        margin-top: 8px;
        border-top: 1px solid var(--border);
    }

    .pur-footer-note {
        font-size: 9px;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: var(--text3);
    }

    /* ── ALERTS ── */
    .pur-alert {
        padding: 12px 16px;
        font-size: 12px;
        margin-bottom: 20px;
        border-left: 3px solid;
        display: flex;
        align-items: center;
        gap: 10px;
        max-width: 800px;
    }

    .pur-alert-success { background: #f0f7f0; border-color: #2d5a2d; color: #2d5a2d; }
    .pur-alert-error   { background: #fdf0f0; border-color: var(--accent); color: var(--accent); }

    @@media (max-width: 640px) {
        .pur-card { padding: 28px 20px; }
        .pur-grid { grid-template-columns: 1fr; }
    }
</style>

@if (TempData["Success"] != null)
{
    <div class="pur-alert pur-alert-success"><span>✓</span> @TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="pur-alert pur-alert-error"><span>✕</span> @TempData["Error"]</div>
}

<div class="pur-header-row">
    <div>
        <div class="pur-eyebrow">Bureau of Risk · Policy Origination</div>
        <h1 class="pur-heading">Policy<br>Application</h1>
        <p class="pur-sub">Configure your coverage parameters and submit a new policy record for underwriting review.</p>
    </div>
    <div class="pur-header-actions">
        <a asp-action="Index" asp-controller="Policy" class="bor-btn bor-btn-outline">← Registry</a>
    </div>
</div>

<form asp-action="Purchase" asp-controller="Policy" method="post" novalidate style="padding-bottom:40px;">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="PolicyTypeId" />

    <div class="pur-card">

        <div class="pur-card-meta">
            <div>
                <div class="pur-card-ref">Form BOR-POL-001 · New Coverage Filing</div>
                <div class="pur-card-title">Policy Application &amp; Registration</div>
            </div>
            <div class="pur-stamp">New Filing</div>
        </div>

        @* Section I — Coverage Parameters *@
        <div class="pur-section">
            <div class="pur-section-head">
                <div class="pur-section-num">I</div>
                <span class="pur-section-label">Coverage Parameters</span>
            </div>

            <div class="pur-grid">
                @* Tenure slider *@
                <div class="pur-field">
                    <label class="field-label" for="Tenure">Coverage Tenure</label>
                    <div class="pur-range-hint">Duration in months (12 – 36)</div>
                    <div class="pur-range-value">
                        <span id="tenureVal">@(Model?.Tenure == 0 ? 12 : Model.Tenure)</span>&nbsp;mo
                    </div>
                    <input type="range"
                           name="Tenure"
                           id="Tenure"
                           class="bor-range"
                           min="12"
                           max="36"
                           value="@(Model?.Tenure == 0 ? 12 : Model.Tenure)" />
                    <div class="pur-range-labels">
                        <span>12 mo</span><span>24 mo</span><span>36 mo</span>
                    </div>
                    <span asp-validation-for="Tenure" class="field-error"></span>
                </div>

                @* Package Amount slider *@
                <div class="pur-field">
                    <label class="field-label" for="PackageAmount">Total Package Value</label>
                    <div class="pur-range-hint">Amount in INR (₹5,000 – ₹15,000)</div>
                    <div class="pur-range-value" id="amountVal">
                        ₹@((Model?.PackageAmount == 0 ? 5000 : Model.PackageAmount).ToString("N0"))
                    </div>
                    <input type="range"
                           name="PackageAmount"
                           id="PackageAmount"
                           class="bor-range"
                           min="5000"
                           max="15000"
                           step="500"
                           value="@(Model?.PackageAmount == 0 ? 5000 : Model.PackageAmount)" />
                    <div class="pur-range-labels">
                        <span>₹5,000</span><span>₹10,000</span><span>₹15,000</span>
                    </div>
                    <span asp-validation-for="PackageAmount" class="field-error"></span>
                </div>
            </div>
        </div>

        @* Section II — Filing Summary *@
        <div class="pur-section">
            <div class="pur-section-head">
                <div class="pur-section-num">II</div>
                <span class="pur-section-label">Filing Summary</span>
            </div>

            <div class="pur-summary-box">
                <div class="pur-summary-row">
                    <span class="pur-summary-label">Policy Type ID</span>
                    <span class="pur-summary-val">TYPE-@((Model?.PolicyTypeId ?? 0).ToString("D3"))</span>
                </div>
                <div class="pur-summary-row">
                    <span class="pur-summary-label">Selected Tenure</span>
                    <span class="pur-summary-val" id="summaryTenure">@(Model?.Tenure == 0 ? 12 : Model.Tenure) months</span>
                </div>
                <div class="pur-summary-row">
                    <span class="pur-summary-label">Package Value</span>
                    <span class="pur-summary-val" id="summaryAmount">₹@((Model?.PackageAmount == 0 ? 5000 : Model.PackageAmount).ToString("N0"))</span>
                </div>
                <div class="pur-summary-row">
                    <span class="pur-summary-label">Status upon Filing</span>
                    <span style="font-size:9px; font-weight:700; letter-spacing:1px; background:#3d2e0a; color:#d4a017; border:1px solid #5a4510; padding:3px 10px; text-transform:uppercase;">Pending Review</span>
                </div>
            </div>
        </div>

        <div class="pur-actions">
            <span class="pur-footer-note">Form BOR-POL-001 · Bureau of Risk</span>
            <div style="display:flex; gap:10px;">
                <a asp-action="Index" asp-controller="Policy" class="bor-btn bor-btn-outline">
                    Abort Filing
                </a>
                <button type="submit" class="bor-btn bor-btn-primary">
                    Submit Application →
                </button>
            </div>
        </div>

    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const tenureSlider  = document.getElementById("Tenure");
        const amountSlider  = document.getElementById("PackageAmount");
        const tenureVal     = document.getElementById("tenureVal");
        const amountVal     = document.getElementById("amountVal");
        const summaryTenure = document.getElementById("summaryTenure");
        const summaryAmount = document.getElementById("summaryAmount");

        tenureSlider.oninput = function () {
            tenureVal.innerText    = this.value;
            summaryTenure.innerText = this.value + " months";
        };

        amountSlider.oninput = function () {
            const fmt = "₹" + parseInt(this.value).toLocaleString("en-IN");
            amountVal.innerText    = fmt;
            summaryAmount.innerText = fmt;
        };
    </script>
}