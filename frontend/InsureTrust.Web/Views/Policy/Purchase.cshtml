@model InsureTrust.Web.Models.CreatePolicyDto

@{
    ViewData["Title"] = "Policy Application";
}

<section class="fade-in-up">
    <div class="page-heading d-flex justify-content-between align-items-center mb-5">
        <div>
            <span class="meta-line"><i class="fa-solid fa-file-contract me-1"></i> Underwriting</span>
            <h1 class="display-5 fw-bold text-white mb-0 mt-2">Policy Origination</h1>
            <p class="text-muted mt-2 fs-5">Configure your coverage parameters and submit a new policy application.</p>
        </div>
        <div class="d-none d-md-flex align-items-center gap-3">
            <a asp-action="Index" asp-controller="Policy" class="btn btn-outline-secondary rounded-pill px-4 text-white border-secondary border-opacity-25 hover-bg-dark">
                <i class="fa-solid fa-arrow-left me-2"></i>Return to Registry
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success bg-success bg-opacity-10 border border-success border-opacity-25 text-success rounded-3 p-3 mb-4 d-flex align-items-center">
            <i class="fa-solid fa-circle-check fs-5 me-2"></i> @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger bg-danger bg-opacity-10 border border-danger border-opacity-25 text-danger rounded-3 p-3 mb-4 d-flex align-items-center">
            <i class="fa-solid fa-triangle-exclamation fs-5 me-2"></i> @TempData["Error"]
        </div>
    }

    <form asp-action="Purchase" asp-controller="Policy" method="post" novalidate class="mb-5">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="PolicyTypeId" />

        <div class="row g-4">
            <div class="col-lg-8">
                <div class="panel-card p-0 overflow-hidden border border-secondary border-opacity-25 rounded-4 h-100">
                    <div class="p-4 bg-dark bg-opacity-50 border-bottom border-secondary border-opacity-25 d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-3">
                            <div class="bg-primary bg-opacity-25 text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                                <i class="fa-solid fa-sliders fs-5"></i>
                            </div>
                            <div>
                                <h4 class="mb-0 text-white fw-bold">Coverage Parameters</h4>
                                <p class="text-muted fs-8 mb-0 text-uppercase tracking-wider">Configure your term and package</p>
                            </div>
                        </div>
                        <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-3 py-2 text-uppercase tracking-wider fs-8">
                            <i class="fa-solid fa-file-pen me-1"></i> New Application
                        </span>
                    </div>

                    <div class="p-5">
                        <div class="mb-5">
                            <div class="d-flex justify-content-between align-items-end mb-3">
                                <div>
                                    <label class="form-label text-white fw-bold fs-5 mb-0" for="Tenure"><i class="fa-solid fa-calendar-days text-primary me-2"></i> Coverage Tenure</label>
                                    <p class="text-muted fs-7 mb-0">Select duration in months</p>
                                </div>
                                <div class="bg-dark bg-opacity-50 border border-secondary border-opacity-25 rounded-3 px-4 py-2">
                                    <span class="fs-3 fw-bold text-white font-monospace" id="tenureVal">@(Model?.Tenure == 0 ? 12 : Model.Tenure)</span>
                                    <span class="text-muted ms-1 text-uppercase fs-7 fw-bold">mo</span>
                                </div>
                            </div>
                            
                            <input type="range"
                                   name="Tenure"
                                   id="Tenure"
                                   class="form-range custom-range"
                                   min="12"
                                   max="36"
                                   value="@(Model?.Tenure == 0 ? 12 : Model.Tenure)" />
                            
                            <div class="d-flex justify-content-between text-muted fs-8 fw-bold mt-2 font-monospace">
                                <span>12 mo</span>
                                <span>24 mo</span>
                                <span>36 mo</span>
                            </div>
                            <span asp-validation-for="Tenure" class="text-danger fs-7 mt-1 d-block"></span>
                        </div>

                        <div class="mb-2">
                            <div class="d-flex justify-content-between align-items-end mb-3">
                                <div>
                                    <label class="form-label text-white fw-bold fs-5 mb-0" for="PackageAmount"><i class="fa-solid fa-indian-rupee-sign text-success me-2"></i> Total Package Value</label>
                                    <p class="text-muted fs-7 mb-0">Select principal amount</p>
                                </div>
                                <div class="bg-dark bg-opacity-50 border border-secondary border-opacity-25 rounded-3 px-4 py-2">
                                    <span class="fs-3 fw-bold text-success font-monospace" id="amountVal">₹@((Model?.PackageAmount == 0 ? 5000 : Model.PackageAmount).ToString("N0"))</span>
                                </div>
                            </div>

                            <input type="range"
                                   name="PackageAmount"
                                   id="PackageAmount"
                                   class="form-range custom-range-success"
                                   min="5000"
                                   max="15000"
                                   step="500"
                                   value="@(Model?.PackageAmount == 0 ? 5000 : Model.PackageAmount)" />
                            
                            <div class="d-flex justify-content-between text-muted fs-8 fw-bold mt-2 font-monospace">
                                <span>₹5,000</span>
                                <span>₹10,000</span>
                                <span>₹15,000</span>
                            </div>
                            <span asp-validation-for="PackageAmount" class="text-danger fs-7 mt-1 d-block"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="panel-card p-0 overflow-hidden border border-primary border-opacity-25 rounded-4 h-100 d-flex flex-column" style="background: linear-gradient(145deg, rgba(15, 23, 42, 0.9), rgba(30, 41, 59, 0.8));">
                    <div class="p-4 bg-primary bg-opacity-10 border-bottom border-primary border-opacity-25">
                        <h4 class="mb-0 text-white fw-bold"><i class="fa-solid fa-clipboard-list me-2"></i> Filing Summary</h4>
                    </div>
                    
                    <div class="p-4 flex-grow-1 d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-center py-3 border-bottom border-secondary border-opacity-25">
                            <span class="text-muted text-uppercase tracking-wider fs-8 fw-bold">Policy Type ID</span>
                            <span class="text-white fw-bold font-monospace bg-dark px-2 py-1 rounded">TYPE-@((Model?.PolicyTypeId ?? 0).ToString("D3"))</span>
                        </div>
                        
                        <div class="d-flex justify-content-between align-items-center py-3 border-bottom border-secondary border-opacity-25">
                            <span class="text-muted text-uppercase tracking-wider fs-8 fw-bold">Selected Tenure</span>
                            <span class="text-white fw-bold font-monospace" id="summaryTenure">@(Model?.Tenure == 0 ? 12 : Model.Tenure) months</span>
                        </div>
                        
                        <div class="d-flex justify-content-between align-items-center py-3 border-bottom border-secondary border-opacity-25">
                            <span class="text-muted text-uppercase tracking-wider fs-8 fw-bold">Package Value</span>
                            <span class="text-success fw-bold fs-5 font-monospace" id="summaryAmount">₹@((Model?.PackageAmount == 0 ? 5000 : Model.PackageAmount).ToString("N0"))</span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center py-3">
                            <span class="text-muted text-uppercase tracking-wider fs-8 fw-bold">Initial Status</span>
                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-3 py-1">Pending Review</span>
                        </div>

                        <div class="mt-auto pt-4 text-center">
                            <button type="submit" class="btn btn-primary w-100 rounded-pill py-3 fw-bold fs-5 shadow-lg mb-3" style="background: linear-gradient(135deg, var(--primary), var(--secondary)); border: none;">
                                Submit Application <i class="fa-solid fa-paper-plane ms-2"></i>
                            </button>
                            
                            <a asp-action="Index" asp-controller="Policy" class="btn btn-link text-muted text-decoration-none hover-text-white d-md-none">
                                Cancel Application
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const tenureSlider  = document.getElementById("Tenure");
        const amountSlider  = document.getElementById("PackageAmount");
        const tenureVal     = document.getElementById("tenureVal");
        const amountVal     = document.getElementById("amountVal");
        const summaryTenure = document.getElementById("summaryTenure");
        const summaryAmount = document.getElementById("summaryAmount");

        tenureSlider.oninput = function () {
            tenureVal.innerText    = this.value;
            summaryTenure.innerText = this.value + " months";
        };

        amountSlider.oninput = function () {
            const fmt = "₹" + parseInt(this.value).toLocaleString("en-IN");
            amountVal.innerText    = fmt;
            summaryAmount.innerText = fmt;
        };
    </script>
    <style>
        .fade-in-up {
            opacity: 0;
            transform: translateY(20px);
            animation: fadeInUp 0.8s ease-out forwards;
        }
        @@keyframes fadeInUp {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        .fs-7 { font-size: 0.85rem; }
        .fs-8 { font-size: 0.75rem; }
        .tracking-wider { letter-spacing: 1px; }
        
        .hover-bg-dark:hover {
            background-color: rgba(255,255,255,0.05);
        }
        .hover-text-white:hover {
            color: white !important;
        }
        
        /* Custom styling for ranges to make them look premium */
        .custom-range::-webkit-slider-thumb {
            background: var(--primary);
            box-shadow: 0 0 10px rgba(13, 138, 188, 0.5);
            width: 20px;
            height: 20px;
            margin-top: -8px;
        }
        .custom-range::-webkit-slider-runnable-track {
            background: rgba(255,255,255,0.1);
            height: 6px;
            border-radius: 3px;
        }
        
        .custom-range-success::-webkit-slider-thumb {
            background: var(--success);
            box-shadow: 0 0 10px rgba(16, 185, 129, 0.5);
            width: 20px;
            height: 20px;
            margin-top: -8px;
        }
        .custom-range-success::-webkit-slider-runnable-track {
            background: rgba(255,255,255,0.1);
            height: 6px;
            border-radius: 3px;
        }
    </style>
}