@model InsureTrust.Productweb.DTOs.PolicyTypeDto

@{
    ViewData["Title"] = Model != null ? $"{Model.Name} · Classification Dossier" : "Record Not Found";
}

<style>
    /* ── POLICY TYPE DOSSIER ── */
    .ptb-header-row {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;
        flex-wrap: wrap;
        margin-bottom: 36px;
    }

    .ptb-eyebrow {
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 2.5px;
        text-transform: uppercase;
        color: var(--text3);
        margin-bottom: 8px;
    }

    .ptb-heading {
        font-family: var(--font-h);
        font-size: 38px;
        font-weight: 900;
        color: var(--text);
        line-height: 1.05;
        margin-bottom: 10px;
        text-transform: uppercase;
    }

    .ptb-header-actions {
        display: flex;
        gap: 10px;
        align-items: center;
        padding-top: 12px;
        flex-shrink: 0;
    }

    /* ── DOSSIER CARD ── */
    .ptb-card {
        background: #fff;
        border: 1px solid var(--border);
        padding: 40px 48px;
        max-width: 860px;
        position: relative;
        z-index: 1;
        margin-bottom: 60px;
    }

    /* ── CARD HEADER ── */
    .ptb-card-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        padding-bottom: 24px;
        margin-bottom: 32px;
        border-bottom: 1px solid var(--border);
        gap: 20px;
    }

    .ptb-ref {
        font-size: 9px;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: var(--text3);
        margin-bottom: 6px;
    }

    .ptb-card-title {
        font-family: var(--font-h);
        font-size: 26px;
        font-weight: 900;
        color: var(--text);
        line-height: 1.1;
        margin-bottom: 6px;
    }

    .ptb-category-pill {
        display: inline-block;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: var(--accent);
        border: 1px solid var(--accent);
        padding: 3px 10px;
    }

    .ptb-icon-stamp {
        width: 72px;
        height: 72px;
        background: var(--bg2);
        border: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 34px;
        flex-shrink: 0;
    }

    /* ── SECTIONS ── */
    .ptb-section {
        margin-bottom: 32px;
    }

    .ptb-section-head {
        display: flex;
        align-items: center;
        gap: 12px;
        padding-bottom: 12px;
        border-bottom: 2px solid var(--text);
        margin-bottom: 20px;
    }

    .ptb-section-num {
        width: 24px;
        height: 24px;
        background: var(--text);
        color: var(--bg);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 10px;
        font-weight: 700;
        flex-shrink: 0;
        font-family: var(--font-h);
    }

    .ptb-section-label {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: var(--text);
    }

    /* ── SUMMARY TEXT ── */
    .ptb-summary {
        font-family: var(--font-doc);
        font-size: 15px;
        color: var(--text2);
        line-height: 1.75;
    }

    /* ── TERMS LIST ── */
    .ptb-terms {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .ptb-terms li {
        padding: 10px 0 10px 20px;
        border-bottom: 1px solid var(--bg2);
        font-size: 13px;
        color: var(--text2);
        line-height: 1.6;
        position: relative;
    }

    .ptb-terms li:last-child {
        border-bottom: none;
    }

    .ptb-terms li::before {
        content: '—';
        position: absolute;
        left: 0;
        color: var(--accent);
        font-weight: 700;
    }

    /* ── FIELDS TABLE ── */
    .ptb-fields-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 12px;
        margin-top: 4px;
    }

    .ptb-fields-table thead tr {
        background: var(--bg2);
    }

    .ptb-fields-table th {
        padding: 10px 14px;
        text-align: left;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: var(--text3);
        border-bottom: 1px solid var(--border);
    }

    .ptb-fields-table td {
        padding: 12px 14px;
        border-bottom: 1px solid var(--bg2);
        color: var(--text2);
        vertical-align: middle;
    }

    .ptb-fields-table tr:last-child td {
        border-bottom: none;
    }

    .ptb-fields-table .field-name-col {
        font-weight: 600;
        color: var(--text);
        font-family: var(--font-b);
        font-size: 12px;
    }

    .ptb-mandatory-tag {
        display: inline-block;
        font-size: 8px;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
        padding: 2px 6px;
        border: 1px solid var(--accent);
        color: var(--accent);
        margin-left: 6px;
        vertical-align: middle;
    }

    .ptb-type-tag {
        display: inline-block;
        font-size: 9px;
        font-weight: 600;
        background: var(--bg2);
        border: 1px solid var(--border);
        padding: 2px 8px;
        color: var(--text2);
    }

    /* ── EMPTY OPTIONAL SECTIONS ── */
    .ptb-empty-section {
        padding: 16px;
        background: var(--bg);
        border: 1px dashed var(--border-dark);
        text-align: center;
        font-size: 11px;
        color: var(--text3);
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    /* ── ACTION ROW ── */
    .ptb-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        padding-top: 28px;
        margin-top: 8px;
        border-top: 1px solid var(--border);
    }

    .ptb-ref-bar {
        font-size: 9px;
        color: var(--text3);
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    /* ── NOT FOUND STATE ── */
    .ptb-not-found {
        text-align: center;
        padding: 100px 20px;
        border: 1px dashed var(--border-dark);
        max-width: 560px;
        margin: 40px auto;
    }

    .ptb-not-found-icon {
        font-size: 48px;
        color: var(--border-dark);
        margin-bottom: 16px;
    }

    .ptb-not-found-title {
        font-family: var(--font-h);
        font-size: 24px;
        font-weight: 900;
        color: var(--text2);
        margin-bottom: 8px;
    }

    .ptb-not-found-sub {
        font-size: 12px;
        color: var(--text3);
        margin-bottom: 24px;
    }
</style>

@if (Model == null)
{
    <div class="ptb-not-found">
        <div class="ptb-not-found-icon">📋</div>
        <div class="ptb-not-found-title">Record Not Located</div>
        <p class="ptb-not-found-sub">The requested classification index does not exist in the registry.</p>
        <a asp-action="Index" class="bor-btn bor-btn-outline">← Return to Registry</a>
    </div>
}
else
{
    <div class="ptb-header-row">
        <div>
            <div class="ptb-eyebrow">Division IV · Classification Registry</div>
            <h1 class="ptb-heading">@Model.Name</h1>
        </div>
        <div class="ptb-header-actions">
            <a asp-action="Index" class="bor-btn bor-btn-outline">← Registry</a>
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="update" asp-route-id="@Model.Id" class="bor-btn bor-btn-outline">Edit</a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="bor-btn bor-btn-danger">Delete</a>
            }
        </div>
    </div>

    <div class="ptb-card">

        @* Card header *@
        <div class="ptb-card-head">
            <div>
                <div class="ptb-ref">Classification Record · Ref TYPE-@Model.Id.ToString("D3")</div>
                <div class="ptb-card-title">@Model.Name</div>
                <span class="ptb-category-pill">@Model.Category Division</span>
            </div>
            <div class="ptb-icon-stamp">
                @(string.IsNullOrEmpty(Model.Icon) ? "📜" : Model.Icon)
            </div>
        </div>

        @* Section I — Executive Summary *@
        <div class="ptb-section">
            <div class="ptb-section-head">
                <div class="ptb-section-num">I</div>
                <span class="ptb-section-label">Executive Summary</span>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <p class="ptb-summary">@Model.Description</p>
            }
            else
            {
                <div class="ptb-empty-section">No summary on file</div>
            }
        </div>

        @* Section II — Coverage Terms *@
        <div class="ptb-section">
            <div class="ptb-section-head">
                <div class="ptb-section-num">II</div>
                <span class="ptb-section-label">Coverage Terms</span>
            </div>
            @if (Model.Terms != null && Model.Terms.Any())
            {
                <ul class="ptb-terms">
                    @foreach (var term in Model.Terms)
                    {
                        <li>@term.TermText</li>
                    }
                </ul>
            }
            else
            {
                <div class="ptb-empty-section">No coverage terms defined</div>
            }
        </div>

        @* Section III — Required Documentation *@
        <div class="ptb-section">
            <div class="ptb-section-head">
                <div class="ptb-section-num">III</div>
                <span class="ptb-section-label">Required Documentation</span>
            </div>
            @if (Model.RequiredFields != null && Model.RequiredFields.Any())
            {
                <div class="bor-table-wrap">
                    <table class="ptb-fields-table">
                        <thead>
                            <tr>
                                <th>Field Identifier</th>
                                <th>Data Type</th>
                                <th>Placeholder</th>
                                <th>Validation</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var field in Model.RequiredFields)
                            {
                                <tr>
                                    <td class="field-name-col">
                                        @field.FieldName
                                        @if (field.IsMandatory)
                                        {
                                            <span class="ptb-mandatory-tag">Required</span>
                                        }
                                    </td>
                                    <td><span class="ptb-type-tag">@field.FieldType</span></td>
                                    <td style="color:var(--text3); font-size:11px;">@(field.Placeholder ?? "—")</td>
                                    <td>
                                        @if (field.IsMandatory)
                                        {
                                            <span style="color:var(--accent); font-size:10px; font-weight:700;">Mandatory</span>
                                        }
                                        else
                                        {
                                            <span style="color:var(--text3); font-size:10px;">Optional</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="ptb-empty-section">No required fields defined</div>
            }
        </div>

        @* Action row *@
        <div class="ptb-actions">
            <span class="ptb-ref-bar">TYPE-@Model.Id.ToString("D3") · Bureau of Risk · Classification Registry</span>
            <div style="display:flex; gap:10px;">
                <a asp-action="Index" class="bor-btn bor-btn-outline">← Registry</a>
                <a asp-action="Purchase" asp-route-id="@Model.Id" class="bor-btn bor-btn-primary">
                    Buy Policy →
                </a>
            </div>
        </div>

    </div>
}