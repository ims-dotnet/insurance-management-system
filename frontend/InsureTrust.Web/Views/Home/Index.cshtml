@{
    ViewData["Title"] = "Dashboard";
}

<section class="profile-shell fade-in-up">
    <div class="page-heading d-flex justify-content-between align-items-center">
        <div>
            <span class="meta-line"><i class="fa-solid fa-shield-halved me-1"></i> Insure Trust Platform</span>
            <h1 class="display-5 fw-bold text-white mb-0 mt-2">Welcome Back.</h1>
            <p class="text-muted mt-2 fs-5">Here's what's happening with your policies today.</p>
        </div>
        <div class="d-none d-md-block text-end">
            <p class="text-muted mb-1" id="currentDateDisplay">Loading Date...</p>
            <div class="badge bg-success-subtle text-success fs-6 px-3 py-2 border border-success-subtle rounded-pill">
                <i class="fa-solid fa-circle-check me-1"></i> System Operational
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="kpi-card p-4 rounded-4 position-relative overflow-hidden h-100">
                <div class="position-absolute top-0 end-0 p-3 opacity-25">
                    <i class="fa-solid fa-shield-cat fa-4x text-primary"></i>
                </div>
                <p class="text-uppercase tracking-wider text-muted mb-1 fw-bold fs-7">Active Policies</p>
                <h2 class="display-4 fw-bolder text-white mb-0">@ViewBag.ActivePolicies</h2>
                <div class="mt-3 text-success fs-7 fw-bold">
                    <i class="fa-solid fa-arrow-trend-up me-1"></i> Secure & Protected
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="kpi-card p-4 rounded-4 position-relative overflow-hidden h-100">
                <div class="position-absolute top-0 end-0 p-3 opacity-25">
                    <i class="fa-solid fa-file-invoice-dollar fa-4x text-warning"></i>
                </div>
                <p class="text-uppercase tracking-wider text-muted mb-1 fw-bold fs-7">Pending Claims</p>
                <h2 class="display-4 fw-bolder text-white mb-0">@ViewBag.PendingClaims</h2>
                <div class="mt-3 text-warning fs-7 fw-bold">
                    <i class="fa-solid fa-clock me-1"></i> Awaiting review
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="kpi-card p-4 rounded-4 position-relative overflow-hidden h-100">
                <div class="position-absolute top-0 end-0 p-3 opacity-25">
                    <i class="fa-solid fa-bell fa-4x text-secondary"></i>
                </div>
                <p class="text-uppercase tracking-wider text-muted mb-1 fw-bold fs-7">New Notifications</p>
                <h2 class="display-4 fw-bolder text-white mb-0" id="dashNotificationCount">@ViewBag.NotificationCount</h2>
                <div class="mt-3 text-muted fs-7 fw-bold">
                    <i class="fa-solid fa-envelope-open-text me-1"></i> Check inbox
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="panel-card h-100">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h3 class="section-title mb-0"><i class="fa-solid fa-calculator text-primary me-2"></i> Premium Estimator</h3>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1">Public Access</span>
                </div>
                <p class="text-muted mb-4">
                    Quickly estimate insurance premiums based on basic parameters.
                </p>
                <div class="bg-dark bg-opacity-25 p-4 rounded-4 border border-secondary border-opacity-25">
                    @await Html.PartialAsync("_Calculator")
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div id="notificationPreview" class="panel-card h-100 d-none">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h3 class="section-title mb-0"><i class="fa-solid fa-bolt text-warning me-2"></i> Activity</h3>
                </div>
                <div class="pe-2" style="max-height: 400px; overflow-y: auto;">
                    <ul id="notificationList" class="list-group list-group-flush gap-2"></ul>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Set current date
            const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
            $('#currentDateDisplay').text(new Date().toLocaleDateString('en-US', options));
            
            // Animation class addition
            setTimeout(() => {
                $('.fade-in-up').addClass('show');
            }, 100);
        });
    </script>
    <style>
        .fade-in-up {
            opacity: 0;
            transform: translateY(20px);
            transition: opacity 0.8s ease-out, transform 0.8s ease-out;
        }
        .fade-in-up.show {
            opacity: 1;
            transform: translateY(0);
        }
        .fs-7 { font-size: 0.85rem; }
        .tracking-wider { letter-spacing: 1px; }
    </style>
}
