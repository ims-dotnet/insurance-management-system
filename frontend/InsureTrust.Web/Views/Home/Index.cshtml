@{
    ViewData["Title"] = "Dashboard";
}

<div class="dashboard-shell">
    <!-- Header Section -->
    <div class="brut-card mb-4 d-flex justify-content-between align-items-center bg-primary" style="background: var(--primary) !important;">
        <div>
            <span class="meta-line fw-black text-uppercase" style="letter-spacing: 2px; font-size: 0.7rem;">
                <i class="fa-solid fa-bolt me-1"></i> System Online
            </span>
            <h1 class="mb-0 mt-1">Welcome, @User.Identity?.Name.</h1>
            <p class="fw-bold mb-0 opacity-75">Your insurance portfolio is currently secure.</p>
        </div>
        <div class="text-end d-none d-md-block">
            <div id="currentDateDisplay" class="fw-black text-uppercase" style="font-size: 0.8rem;"></div>
            <div class="mt-2">
                <span class="badge bg-black text-white rounded-0 px-3 py-2 border-0">
                    <i class="fa-solid fa-circle-check me-1 text-success"></i> OPERATIONAL
                </span>
            </div>
        </div>
    </div>

    <!-- KPI Grid -->
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="brut-card h-100 position-relative overflow-hidden">
                <div class="position-absolute top-0 end-0 p-3 opacity-10">
                    <i class="fa-solid fa-shield-halved fa-4x"></i>
                </div>
                <p class="text-uppercase fw-black fs-8 mb-2">Active Policies</p>
                <h2 class="display-5 mb-0">@ViewBag.ActivePolicies</h2>
                <div class="mt-3 text-success fw-bold fs-8">
                    <i class="fa-solid fa-check-double me-1"></i> FULLY PROTECTED
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="brut-card h-100 position-relative overflow-hidden border-secondary" style="border-color: var(--secondary) !important;">
                <div class="position-absolute top-0 end-0 p-3 opacity-10">
                    <i class="fa-solid fa-file-signature fa-4x"></i>
                </div>
                <p class="text-uppercase fw-black fs-8 mb-2">Pending Claims</p>
                <h2 class="display-5 mb-0">@ViewBag.PendingClaims</h2>
                <div class="mt-3 text-danger fw-bold fs-8">
                    <i class="fa-solid fa-clock me-1"></i> NEEDS ATTENTION
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="brut-card h-100 position-relative overflow-hidden border-accent" style="border-color: var(--accent) !important;">
                <div class="position-absolute top-0 end-0 p-3 opacity-10">
                    <i class="fa-solid fa-bell fa-4x"></i>
                </div>
                <p class="text-uppercase fw-black fs-8 mb-2">Notifications</p>
                <h2 class="display-5 mb-0" id="dashNotificationCount">@ViewBag.NotificationCount</h2>
                <div class="mt-3 text-primary fw-bold fs-8">
                    <i class="fa-solid fa-envelope me-1"></i> UNREAD MESSAGES
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Area -->
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="brut-card h-100">
                <div class="d-flex justify-content-between align-items-center mb-4 border-bottom border-2 border-dark pb-3">
                    <h3 class="mb-0"><i class="fa-solid fa-calculator me-2"></i> Premium Estimator</h3>
                    <span class="badge bg-secondary text-white rounded-0 px-3">TOOLS</span>
                </div>
                <p class="fw-bold mb-4">Calculate your investment returns and coverage premiums instantly.</p>
                
                <div class="bg-light p-4 border border-2 border-dark">
                    @await Html.PartialAsync("_Calculator")
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div id="notificationPreview" class="brut-card h-100 d-none">
                <div class="d-flex justify-content-between align-items-center mb-4 border-bottom border-2 border-dark pb-3">
                    <h3 class="mb-0"><i class="fa-solid fa-rss me-2"></i> Activity</h3>
                </div>
                <div class="pe-2" style="max-height: 450px; overflow-y: auto;">
                    <ul id="notificationList" class="list-group list-group-flush gap-3"></ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
            $('#currentDateDisplay').text(new Date().toLocaleDateString('en-US', options));
            
            // Check if activity has items
            setTimeout(() => {
                if ($('#notificationList li').length > 0) {
                    $('#notificationPreview').removeClass('d-none');
                }
            }, 500);
        });
    </script>
}
