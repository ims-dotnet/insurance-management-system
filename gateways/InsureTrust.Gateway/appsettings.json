{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",

  "Cors": {
    "AllowedOrigins": [
      "https://localhost:7282",
      "http://localhost:5137"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "notification-send-route": {
        "ClusterId": "identity-cluster",
        "Order": 1,
        "Match": {
          "Path": "/api/notifications/send"
        }
      },
      "notification-route": {
        "ClusterId": "notification-cluster",
        "Order": 2,
        "Match": {
          "Path": "/api/notifications/{**catch-all}"
        }
      },
      "calculator-route": {
        "ClusterId": "calculator-cluster",
        "Match": {
          "Path": "/api/calculator/{**catch-all}"
        }
      },
      "product-route": {
        "ClusterId": "product-cluster",
        "Match": {
          "Path": "/api/policy/{**catch-all}"
        }
      },
      "claim-route": {
        "ClusterId": "claim-cluster",
        "Match": {
          "Path": "/api/claim/{**catch-all}"
        }
      },
      "payment-route": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/api/payment/{**catch-all}"
        }
      },
      "admin-route": {
        "ClusterId": "admin-cluster",
        "Match": {
          "Path": "/api/admin/{**catch-all}"
        }
      },
      "query-route": {
        "ClusterId": "query-cluster",
        "Match": {
          "Path": "/api/queries/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity-service": {
            "Address": "https://localhost:7001"
          }
        }
      },
      "calculator-cluster": {
        "Destinations": {
          "calculator-service": {
            "Address": "https://localhost:7005"
          }
        }
      },
      "product-cluster": {
        "Destinations": {
          "product-service": {
            "Address": "https://localhost:7296"
          }
        }
      },
      "claim-cluster": {
        "Destinations": {
          "claim-service": {
            "Address": "https://localhost:7147"
          }
        }
      },
      "payment-cluster": {
        "Destinations": {
          "payment-service": {
            "Address": "https://localhost:7003"
          }
        }
      },
      "admin-cluster": {
        "Destinations": {
          "admin-service": {
            "Address": "https://localhost:7009"
          }
        }
      },
      "query-cluster": {
        "Destinations": {
          "query-service": {
            "Address": "https://localhost:7042"
          }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "notification-service": {
            "Address": "https://localhost:7016"
          }
        }
      }
    }
  }
}